[Unit]
Description=z2r autotune daemon (health-check + point re-tune)
After=network-online.target zapret2.service
Wants=network-online.target
# Демон сам проверяет zapret2_running() в цикле и просто ждёт, если сервис
# не поднят — но естественный порядок всё равно лучше при загрузке системы.
# Именно Wants=, а не Requires=: zapret2.service штатно уходит в
# inactive (dead) через пару секунд после старта (форкает nfqws2 в обход
# systemd-cgroup, само по себе это не сбой). С Requires= это вызывало
# каскадный рестарт autotune-daemon.service при каждом
# `systemctl restart zapret2` — увидено на NETH-4 при проверке.
Wants=zapret2.service
# Демон сам себя защищает от повторного запуска (flock на
# autotune_state/daemon.singleton.lock), так что двойной старт тут не
# страшен — но не даём systemd уходить в частый restart-loop, если
# что-то пошло не так на самом старте.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/bash /opt/z2r_autobench/autotune_daemon.sh
Restart=on-failure
RestartSec=10
User=root
# Логи демон и так дублирует в /opt/z2r_autobench/autotune_state/daemon.log,
# но пусть заодно идут и в journal — удобно смотреть `journalctl -u autotune-daemon -f`
StandardOutput=journal
StandardError=journal

# Переопределить настройки можно тут, например:
# Environment=CHECK_INTERVAL=180
# Environment=FAIL_THRESHOLD=2
# Environment=RETUNE_BACKOFF=3600
#
# С 2026-08-18 профили 1-6 переехали на отдельные процессы
# autotune-profile@N.service (см. autotune-profile@.service в этом же
# комплекте) -- этому, легаси, оставлены только 8/9 (и так почти всегда
# пропускаются, см. комментарий у SKIP_PROFILES в autotune_daemon.sh).
# ВАЖНО про кавычки: без них systemd режет строку по пробелам как
# отдельные Environment-присваивания и все значения после первого
# теряются (наступили на это на NETH-4) -- кавычки обязательны.
Environment="SKIP_PROFILES=1 2 3 4 5 6"

[Install]
WantedBy=multi-user.target
