# Оставлен для --uninstall (CLI-флаг, без меню) — спрашивает про оба
# компонента по очереди, как и раньше.
uninstall_stack() {
  uninstall_daemon
  echo ""
  uninstall_z2r
}

# Пункт меню 999 — пройтись по всем компонентам подряд (демон, z2r,
# Discord_bot, сам автобенч), каждый со своим подтверждением.
# uninstall_autobench_self сам завершает процесс (exit), поэтому его
