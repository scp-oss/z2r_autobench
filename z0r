# Живой инцидент 2026-08-13: uninstall_z2r() сносил /opt/zapret2, пока
# песочный nfqws2 Зенита (sandbox/start_sandbox.sh -- ОТДЕЛЬНЫЙ процесс от
# основного zapret2.service, свой systemd тут не используется) всё ещё
# работал и держал открытыми хостлисты из-под удалённого /opt/zapret2 --
# результат: бесконечный залив терминала "file_mod_signature: No such
# file or directory" на каждую попытку перечитать конфиг. teardown_sandbox.sh
# сам останавливает nfqws2 первым делом (см. его докстринг) -- вызываем
# ПЕРЕД любым rm -rf, что тут, что в uninstall_z2r(). pkill -- отдельная
# страховка на случай, если sandbox уже не в том состоянии, которое
# teardown_sandbox.sh ожидает (osiротевший процесс без queue_num и т.п.).
stop_zenith_sandbox_if_running() {
  if [ -x "$ZENITH_DIR/sandbox/teardown_sandbox.sh" ]; then
    ( cd "$ZENITH_DIR/sandbox" && ./teardown_sandbox.sh ) || true
  fi
  pkill -9 -x nfqws2 2>/dev/null || true
}

uninstall_zenith() {
  if [ ! -d "$ZENITH_DIR" ]; then
    echo "Zenith ($ZENITH_DIR) не найден — нечего удалять."
    return 0
  fi
  if [ "$(zenith_db_mode)" = "api" ]; then
    read -re -p "Найден $ZENITH_DIR (БД — панель, тут нечего останавливать) — удалить папку? [y/N]: " ans
  elif [ "$(zenith_db_backend)" = "native" ]; then
    read -re -p "Найден $ZENITH_DIR — удалить папку? (БД нативная, mariadb НЕ трогаю) [y/N]: " ans
  else
    read -re -p "Найден $ZENITH_DIR — остановить контейнеры и удалить (вместе с БД в volume)? [y/N]: " ans
  fi
  case "$ans" in
    y|Y)
      stop_zenith_sandbox_if_running
      # Автономный режим (см. zenith_autonomy_menu) — отдельные systemd-юниты,
      # не завязаны на docker compose, останавливаем/удаляем явно, иначе
      # zenith-promoter.service продолжит дёргать уже удалённый ZENITH_DIR.
      for unit in zenith-autorun zenith-promoter; do
        if [ -f "/etc/systemd/system/${unit}.service" ]; then
          systemctl disable --now "$unit" 2>/dev/null || true
          rm -f "/etc/systemd/system/${unit}.service"
        fi
      done
      systemctl daemon-reload 2>/dev/null || true
      if [ "$(zenith_db_mode)" != "api" ] && [ "$(zenith_db_backend)" != "native" ]; then
        ( cd "$ZENITH_DIR" && docker compose down -v ) 2>/dev/null
      fi
      rm -rf "$ZENITH_DIR"
      echo "Zenith удалён."
      ;;
    *) echo "Отмена, Zenith не тронут." ;;
  esac
}

