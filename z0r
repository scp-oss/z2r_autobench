zenith_show_provider_strategies() {
  if [ "$(zenith_db_mode)" = "api" ]; then
    echo "БД — панель, своей тут нет: этот обзор недоступен из CLI в режиме api."
    echo "Смотри на панели: $(zenith_env_get PANEL_URL)/"
    return 0
  fi
  echo "Текущий провайдер: $(get_provider)"
  echo ""
  # Общий срез по всем профилям сразу — колонка profile отличает пулы
  # (см. schema.sql: геном не шарится между профилями). Для одного
  # конкретного профиля — пункт 3, zenith_query_profile().
  # id обрезан до 12 символов для читаемости — полный есть в БД (это
  # sha256, не что-то, что нужно вводить руками).
  local out
  out="$(zenith_mysql_query "
    SELECT g.profile, SUBSTRING(g.id,1,12) AS id, g.family, g.fooling, g.ttl_mode,
           gs.pulls, gs.successes,
           ROUND(gs.total_reward / NULLIF(gs.pulls,0), 3) AS avg_score,
           en.name AS environment
    FROM genome_scores gs
    JOIN genomes g ON g.id = gs.genome_id
    JOIN environments en ON en.id = gs.environment_id
    ORDER BY g.profile, avg_score DESC
    LIMIT 40;")"
  if [ -n "$out" ]; then
    echo "$out"
  else
    echo "(пусто — генератор ещё не запускался или ничего не нашёл, см. README Zenith)"
  fi
}

zenith_query_profile() {
  local profile="$1"
  if [ "$(zenith_db_mode)" = "api" ]; then
    echo "БД — панель, своей тут нет: этот обзор недоступен из CLI в режиме api."
    echo "Смотри на панели: $(zenith_env_get PANEL_URL)/knowledge (или /genome/<id>)"
    return 0
  fi
  echo "Профиль: $profile"
  echo ""
  # genomes.profile — отдельный пул генома на профиль (не шарится между
  # профилями даже при совпадении rendered_args), поэтому фильтр прямой,
  # без обхода через experiments/domain_pool.profile_hint.
  # SUM()/ROUND(SUM.../SUM...), не голые gs.pulls/gs.successes — genome_scores
  # ключуется (genome_id, environment_id), так что при нескольких окружениях
  # (будущие ВМ ростелеком/МТС) на один genome_id могут быть НЕСКОЛЬКО строк;
  # без агрегации это падало с ONLY_FULL_GROUP_BY (проверено вживую).
  local out
  out="$(zenith_mysql_query "
    SELECT SUBSTRING(g.id,1,12) AS id, g.family, g.fooling, g.ttl_mode,
           SUM(gs.pulls) AS pulls, SUM(gs.successes) AS successes,
           ROUND(SUM(gs.total_reward) / NULLIF(SUM(gs.pulls),0), 3) AS avg_score
    FROM genome_scores gs
    JOIN genomes g ON g.id = gs.genome_id AND g.profile = '$profile'
    GROUP BY g.id, g.family, g.fooling, g.ttl_mode
    ORDER BY avg_score DESC
    LIMIT 20;")"
  if [ -n "$out" ]; then
    echo "$out"
  else
    echo "(пусто — генератор ещё не запускался или ничего не нашёл, см. README Zenith)"
  fi
}

