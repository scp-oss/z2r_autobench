# После теста профиля предлагает применить лучшую (первую в ORDERED_SUCCESS)
# стратегию — то же самое, что делает retune_profile() в autotune_daemon.sh,
# но через set_strategy_cli.sh (не сорсим лишний раз всю lib внутри z0r).
offer_apply_best() {
  local pid="$1" ordered best proto
  case "$pid" in 6|7) return 0 ;; esac
  ordered="$(read_last_ordered "$pid")"
  best="$(awk '{print $1; exit}' <<< "$ordered")"
  [ -n "$best" ] || return 0

  # Не в интерактиве (например, z0r --profiles ... из cron/автоматизации,
  # без TTY) — не виснем на read, просто сообщаем находку.
  if [ ! -t 0 ]; then
    echo "Профиль $pid (${TITLES[$pid]}): лучшая стратегия $best (не интерактив — не применяю автоматически, см. --apply-механизм демона для авто-режима)."
    return 0
  fi

  read -re -p "Профиль $pid (${TITLES[$pid]}): применить лучшую стратегию $best? [y/N]: " ans
  case "$ans" in
    y|Y)
      for proto in ${PROFILE_PROTO[$pid]:-tls}; do
        bash "$SCRIPT_DIR/set_strategy_cli.sh" set "$pid" "$proto" "$best"
      done
      ;;
    *) echo "Пропускаю профиль $pid — стратегия не применена." ;;
  esac
}

# Без вопроса применяет лучшую стратегию профиля — используется вместо
# offer_apply_best для профилей, которые в этом прогоне являются
# зависимостью для другого протестированного профиля (см. PROFILE_DEPENDS_ON):
# зависящий тест всё равно провалится, если не подставить рабочую стратегию
# зависимости прямо сейчас, поэтому спрашивать тут нечего.
apply_best_auto() {
  local pid="$1" ordered best proto
  ordered="$(read_last_ordered "$pid")"
  best="$(awk '{print $1; exit}' <<< "$ordered")"
  if [ -z "$best" ]; then
    echo "Профиль $pid (${TITLES[$pid]}): рабочей стратегии не нашлось — зависящие от него профили ниже могут показать ложный провал."
    return 0
  fi
  echo "Профиль $pid (${TITLES[$pid]}): применяю стратегию $best автоматически, без вопроса — от неё зависит корректность теста следующих профилей."
  for proto in ${PROFILE_PROTO[$pid]:-tls}; do
    bash "$SCRIPT_DIR/set_strategy_cli.sh" set "$pid" "$proto" "$best"
  done
}

# Ручное переключение стратегии профиля на конкретный номер, без прогона
# rank_strategies.sh/rank_quic.sh — для быстрой точечной проверки (например,
# сверить номер из чужой статистики или руками попробовать конкретную
# стратегию). Профиль 7 (GAMES_UDP) исключён — тестер не реализован, у
# профиля нет согласованного числа стратегий, ставить туда что-то вручную
# бессмысленно.
manual_switch_strategy() {
  echo ""
  echo "=== Ручное переключение стратегии ==="
  local pid
  for pid in 1 2 3 4 5 6 8 9; do
    printf "  %s) %-18s [#%s]\n" "$pid" "${TITLES[$pid]}" "$(get_locked_strategy "$pid")"
  done
  read -re -p "Профиль: " pid
  case " 1 2 3 4 5 6 8 9 " in
    *" $pid "*) ;;
    *) echo "Нет такого профиля (или для него нет ручного переключения)."; return 1 ;;
  esac

  local cur strat proto ans
  cur="$(get_locked_strategy "$pid")"
  echo "Текущая стратегия профиля $pid (${TITLES[$pid]}): $cur"
  read -re -p "Новый номер стратегии: " strat
  if ! printf '%s' "$strat" | grep -Eq '^[0-9]+$'; then
    echo "Стратегия должна быть числом."
    return 1
  fi

  read -re -p "Применить strategy=$strat к профилю $pid (${TITLES[$pid]})? [y/N]: " ans
  case "$ans" in
    y|Y)
      for proto in ${PROFILE_PROTO[$pid]:-tls}; do
        bash "$SCRIPT_DIR/set_strategy_cli.sh" set "$pid" "$proto" "$strat"
      done
      echo "Применено: профиль $pid (${TITLES[$pid]}) -> strategy=$strat (было $cur)."
      ;;
    *) echo "Отменено." ;;
  esac
}

run_all() {
  local all_ids="1 2 3 4 5 6 7 8 9" auto_ids
  auto_ids="$(compute_auto_ids "$all_ids")"

  echo "=== Полный прогон всех тестируемых профилей ($PASSES проход(ов) на TLS/QUIC) ==="
  echo ""
  for pid in $all_ids; do
    test_profile "$pid"
    echo ""
    case " $auto_ids " in
      *" $pid "*) apply_best_auto "$pid" ;;
      *) offer_apply_best "$pid" ;;
    esac
    echo ""
  done
  echo "=== ИТОГ ==="
  for pid in 1 2 3 4 5 6 7 8 9; do
    local title="${TITLES[$pid]}"
    if [ "$pid" = "7" ]; then
      echo "$pid $title: тестер не реализован (сделаем позже)"
      continue
    fi
    local ordered
    ordered="$(read_last_ordered "$pid")"
    echo "$pid $title: ${ordered:-нет данных}"
  done
}

