  echo "     (можно перечислить несколько через запятую/пробел, например: 1,3,4)" >&2
  echo "" >&2
  for pid in 1 2 3 4 5; do
    printf "  %s) %-18s [#%s]\n" "$pid" "${TITLES[$pid]}" "$(get_locked_strategy "$pid")" >&2
  done
