#!/usr/bin/env bash
# z0r — единая точка входа для z2r_autobench: тестирование профилей z2r,
# автонастройка (демон) и bootstrap самого себя — по аналогии с тем, как
# ставят сам z2r (curl -O .../z2r && sh z2r), можно точно так же:
#
#   curl -O https://raw.githubusercontent.com/scp-oss/z2r_autobench/main/z0r && sh z0r
#
# При запуске НЕ из установленного /opt/z2r_autobench (то есть при самом
# первом запуске свежескачанного файла) z0r сам:
#   - ставит z2r (ядро DPI-обхода), если его ещё нет;
#   - клонирует полный z2r_autobench в /opt/z2r_autobench (если уже
#     склонирован — просто обновляет через git pull);
#   - предлагает поставить фоновый демон автотестирования-автоподстройки
#     (autotune-daemon), если он ещё не установлен — отказался, ничего
#     страшного: демон физически не появится, значит при следующем запуске
#     z0r снова предложит поставить, без отдельного "запоминания отказа";
#   - и наконец перезапускает себя уже из установленной копии.
# При запуске ИЗ УЖЕ установленной копии (обычный "sudo ./z0r" внутри
# /opt/z2r_autobench) — просто тихо подтягивает обновления (git pull, если
# есть доступ к GitHub) и сразу открывает меню/выполняет переданные флаги.
#
# ВАЖНО: подскрипты (rank_strategies.sh/rank_quic.sh) вызываются НАПРЯМУЮ,
# без $(...)-захвата — иначе весь live-вывод (прогресс-бар, "проход N/M")
# уходит в чёрную дыру до самого завершения команды (так и было раньше,
# из-за этого казалось что тест завис). Результат для сводки читаем не
# из stdout, а из файла last_ordered_profile_<N>.txt, который каждый
# подскрипт пишет сам по итогу работы — это разделяет "что показать live"
# и "что вернуть как результат", не заставляя их конфликтовать.
#
# Запуск:
#   sudo ./z0r                  — интерактивное меню
#   sudo ./z0r --profile 1      — тест одного профиля, без меню
#   sudo ./z0r --profiles 1,3,4 — тест выборочного набора профилей
#   sudo ./z0r --all            — все тестируемые профили подряд
#   sudo ./z0r --all --passes 5 — тот же с другим числом проходов
#   sudo ./z0r --domain example.com [--passes 3] [--apply]
#                                — тест конкретного домена (см. ниже)
#   sudo ./z0r --install-service
#                                — установить+включить autotune-daemon.service
#                                  (без меню, для git clone && запусти-и-готово)
#   sudo ./z0r --install-z2r    — поставить сам z2r (ядро DPI-обхода), если его нет
#   sudo ./z0r --uninstall      — удалить autotune-daemon.service и/или z2r
#                                  (с подтверждением на каждый найденный компонент)
#
# Ниже используются bash-конструкции (declare -A, ${BASH_SOURCE[0]}), поэтому
# скрипт требует bash. Но ставят z2r обычно через "sh z2r" (см. установщик
# автора z2r) — по аналогии кто-нибудь запустит и нас через "sh z0r"/POSIX-sh,
# где всё это упадёт синтаксической ошибкой ещё до первой содержательной
# строки. Ловим это ДО любого башизма и перезапускаемся под bash, ставя его
# при необходимости тем же способом, что и установщик z2r (apt/opkg/apk/...).
if [ -z "${BASH_VERSION:-}" ]; then
  if command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
  echo "z0r требует bash, а его нет в системе — пробую поставить..." >&2
  apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
  apt-get install -y bash >/dev/null 2>&1 || opkg install bash >/dev/null 2>&1 || apk add bash >/dev/null 2>&1
  if command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
  echo "Не удалось поставить bash — z0r без него не запустится. Поставь bash вручную и перезапусти." >&2
  exit 1
fi

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="/opt/z2r_autobench"
INSTALLED_Z0R="$INSTALL_DIR/z0r"
REPO_URL="https://github.com/scp-oss/z2r_autobench.git"
LOG_DIR="/opt/z2r_autobench/logs"
PASSES="${PASSES:-3}"
MODE=""
SINGLE_PROFILE=""
SELECTED_PROFILES=""
CUSTOM_DOMAIN=""
APPLY_FLAG=""

# Зеркала официального установщика z2r (не наш код — просто то, чем сейчас
# ставят z2r вручную; второе зеркало для тех, у кого GitHub недоступен).
Z2R_INSTALL_URL_PRIMARY="https://raw.githubusercontent.com/AloofLibra/z4r/z2r/z2r"
Z2R_INSTALL_URL_FALLBACK="https://git.px.rkn.quest/z2r/plain/z2r?h=z2r"

# запоминаем исходные аргументы ДО разбора (который их shift'ит) — нужны
# нетронутыми, если ниже придётся перезапускаться из установленной копии
ORIG_ARGS=("$@")

while [ $# -gt 0 ]; do
  case "$1" in
    --profile) SINGLE_PROFILE="$2"; MODE="single"; shift 2 ;;
    --profiles) SELECTED_PROFILES="$2"; MODE="selected"; shift 2 ;;
    --all) MODE="all"; shift ;;
    --domain) CUSTOM_DOMAIN="$2"; MODE="domain"; shift 2 ;;
    --passes) PASSES="$2"; shift 2 ;;
    --apply) APPLY_FLAG="--apply"; shift ;;
    --install-service) MODE="install"; shift ;;
    --install-z2r) MODE="install-z2r"; shift ;;
    --uninstall) MODE="uninstall"; shift ;;
    *) echo "Неизвестный аргумент: $1" >&2; exit 1 ;;
  esac
done

if [ "$(id -u)" != "0" ]; then
  echo "Нужен root." >&2
  exit 1
fi

declare -A TITLES=(
  [1]="YT_TLS"
  [2]="GV_TLS"
  [3]="RKN_TLS"
  [4]="DS_TLS"
  [5]="YT_QUIC_UDP"
  [6]="VOICE_UDP"
  [7]="GAMES_UDP"
  [8]="FB_TLS"
  [9]="FB_HTTP"
)

read_last_ordered() {
  # $1 = profile id, печатает содержимое last_ordered_profile_<N>.txt или пусто
  local f="$LOG_DIR/last_ordered_profile_$1.txt"
  [ -f "$f" ] && cat "$f" || echo ""
}

test_profile() {
  local pid="$1"
  local title="${TITLES[$pid]}"

  case "$pid" in
    1|2|3|4|8|9)
      echo "--- Тестирую $title (профиль $pid), $PASSES проход(ов) ---"
      bash "$SCRIPT_DIR/rank_strategies.sh" --profile "$pid" --passes "$PASSES"
      local ordered
      ordered="$(read_last_ordered "$pid")"
      echo ""
      echo ">>> $pid $title: ${ordered:-нет успешных}"
      ;;
    5)
      echo "--- Тестирую $title (профиль 5, QUIC), $PASSES проход(ов) ---"
      bash "$SCRIPT_DIR/rank_quic.sh" --passes "$PASSES"
      local ordered
      ordered="$(read_last_ordered "5")"
      echo ""
      echo ">>> $pid $title: ${ordered:-нет успешных}"
      ;;
    6)
      echo "--- $title (профиль 6): читаю уже накопленные данные бота ---"
      if [ -f "$LOG_DIR/voice_bot_raw.tsv" ]; then
        bash "$SCRIPT_DIR/parse_voice_rank.sh"
        local ordered
        ordered="$(read_last_ordered "6")"
        echo ""
        if [ -n "$ordered" ]; then
          echo ">>> $pid $title: $ordered"
        else
          echo ">>> $pid $title: данные есть, но нет успешных стратегий (или файл пуст)"
        fi
      else
        echo ">>> $pid $title: нет данных — запусти /voice_rank в Discord-боте хотя бы раз"
      fi
      ;;
    7)
      echo ">>> $pid $title: тестер не реализован (сделаем позже)"
      ;;
    *)
      echo ">>> $pid $title: неизвестный профиль" >&2
      ;;
  esac
}

show_menu() {
  echo "=== z0r ===" >&2
  echo "Профили:" >&2
  for pid in 1 2 3 4 5 6 7 8 9; do
    echo "  $pid) ${TITLES[$pid]}" >&2
  done
  echo "  0) Все тестируемые профили (1,2,3,4,5,8,9 полным тестом; 6 — из кэша; 7 — заглушка)" >&2
  echo "  1,3,4 (через запятую/пробел) — выборочный тест нескольких профилей" >&2
  echo "  d) Тест конкретного домена (найти рабочие стратегии для своего сайта)" >&2
  echo "  i) Установить/включить сервис автотестирования-автоподстройки (autotune-daemon)" >&2
  echo "  z) Установить/обновить сам z2r (ядро DPI-обхода)" >&2
  echo "  u) Удалить z2r и/или autotune-daemon.service (с подтверждением)" >&2
  echo "  q) Выход" >&2
  echo "" >&2
  read -re -p "Выбор: " choice
  echo "$choice"
}

run_all() {
  echo "=== Полный прогон всех тестируемых профилей ($PASSES проход(ов) на TLS/QUIC) ==="
  echo ""
  for pid in 1 2 3 4 5 6 7 8 9; do
    test_profile "$pid"
    echo ""
  done
  echo "=== ИТОГ ==="
  for pid in 1 2 3 4 5 6 7 8 9; do
    local title="${TITLES[$pid]}"
    if [ "$pid" = "7" ]; then
      echo "$pid $title: тестер не реализован (сделаем позже)"
      continue
    fi
    local ordered
    ordered="$(read_last_ordered "$pid")"
    echo "$pid $title: ${ordered:-нет данных}"
  done
}

run_domain_test() {
  local domain="$1"
  echo "--- Тест домена $domain (через профиль 3/RKN-механику, как z2r делает для custom-доменов) ---"
  bash "$SCRIPT_DIR/test_custom_domain.sh" --domain "$domain" --passes "$PASSES" $APPLY_FLAG
}

# Выборочный прогон набора профилей: "1,3,4" или "1 3 4"
run_selected() {
  local raw="$1" ids pid
  ids="$(echo "$raw" | tr ',' ' ')"

  echo "=== Выборочный прогон профилей: $ids ($PASSES проход(ов) на TLS/QUIC) ==="
  echo ""
  for pid in $ids; do
    if [ -z "${TITLES[$pid]:-}" ]; then
      echo "Пропускаю неизвестный профиль: $pid" >&2
      continue
    fi
    test_profile "$pid"
    echo ""
  done

  echo "=== ИТОГ (выборочно) ==="
  for pid in $ids; do
    [ -n "${TITLES[$pid]:-}" ] || continue
    if [ "$pid" = "7" ]; then
      echo "$pid ${TITLES[$pid]}: тестер не реализован (сделаем позже)"
      continue
    fi
    local ordered
    ordered="$(read_last_ordered "$pid")"
    echo "$pid ${TITLES[$pid]}: ${ordered:-нет данных}"
  done
}

# Установить и (по желанию) включить autotune-daemon.service — фоновый демон,
# который сам тестирует профили по health-check-триггеру и подставляет лучшую
# стратегию в locked.tsv/profile.lock (см. autotune_daemon.sh). $1=1 —
# без интерактивного вопроса сразу enable --now (для --install-service).
install_daemon_service() {
  local noninteractive="${1:-0}"
  local unit_src="$SCRIPT_DIR/autotune-daemon.service"
  local unit_dst="/etc/systemd/system/autotune-daemon.service"

  if [ ! -f "$unit_src" ]; then
    echo "Не найден $unit_src — что-то не так с чекаутом репозитория." >&2
    return 1
  fi

  echo "Устанавливаю $unit_dst <- $unit_src"
  cp -f "$unit_src" "$unit_dst"
  systemctl daemon-reload

  echo ""
  echo "Проверка внешних зависимостей (демон и сам это проверяет в рантайме и"
  echo "временно пропускает соответствующие профили, если чего-то нет — но"
  echo "лучше знать заранее):"
  if command -v yt-dlp >/dev/null 2>&1; then
    echo "  yt-dlp: OK ($(yt-dlp --version 2>/dev/null))"
  else
    echo "  yt-dlp: НЕ НАЙДЕН — профили 2 (GV_TLS) и 5 (YT_QUIC_UDP) будут временно пропущены."
    echo "          Установи: pip install yt-dlp --break-system-packages"
  fi
  if python3 -c "import aioquic" >/dev/null 2>&1; then
    echo "  aioquic: OK"
  else
    echo "  aioquic: НЕ НАЙДЕН — профиль 5 (YT_QUIC_UDP) будет временно пропущен."
    echo "           Установи: pip install aioquic --break-system-packages"
  fi
  echo ""

  if [ "$noninteractive" = "1" ]; then
    systemctl enable --now autotune-daemon
    sleep 2
    systemctl status autotune-daemon --no-pager
    return 0
  fi

  read -re -p "Включить и запустить autotune-daemon.service сейчас? [Y/n]: " ans
  case "$ans" in
    n|N) echo "Юнит установлен, но не запущен. Запустить вручную: systemctl enable --now autotune-daemon" ;;
    *)
      systemctl enable --now autotune-daemon
      sleep 2
      systemctl status autotune-daemon --no-pager
      ;;
  esac
}

# z2r (ядро DPI-обхода) ставится собственным установщиком автора, не нашим
# кодом — мы только определяем, стоит ли он, и по запросу скачиваем/запускаем
# тот же установщик, которым обычно ставят z2r руками.
z2r_installed() {
  [ -d /opt/zapret2 ] && [ -x /opt/zapret2/init.d/sysv/zapret2 ]
}

ensure_curl() {
  command -v curl >/dev/null 2>&1 && return 0
  echo "curl не найден, пробую поставить..." >&2
  apt update || opkg update || apk update && apt install curl || opkg install curl || apk add curl
  command -v curl >/dev/null 2>&1
}

install_z2r() {
  if z2r_installed; then
    read -re -p "z2r уже установлен (/opt/zapret2 есть). Переустановить/обновить поверх? [y/N]: " ans
    case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac
  fi

  if ! ensure_curl; then
    echo "curl не найден и не удалось поставить — установи z2r вручную." >&2
    return 1
  fi

  echo "Сейчас будет скачан и ЗАПУЩЕН установочный скрипт z2r от его автора"
  echo "(не наш код, выполняется с root). Убедись, что доверяешь источнику."
  read -re -p "Продолжить установку z2r? [y/N]: " ans
  case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

  echo "Пробую основное зеркало (GitHub)..."
  if ( cd /tmp && curl -fO "$Z2R_INSTALL_URL_PRIMARY" && sh z2r ); then
    echo "z2r установлен (основное зеркало)."
    return 0
  fi

  echo "Основное зеркало недоступно, пробую резервное (git.px.rkn.quest)..."
  if curl -fo /opt/z2r "$Z2R_INSTALL_URL_FALLBACK" && sh /opt/z2r; then
    echo "z2r установлен (резервное зеркало)."
    return 0
  fi

  echo "Не удалось установить z2r ни с одного зеркала." >&2
  return 1
}

# Удаляет наш демон-сервис и/или сам z2r — по одному подтверждению на каждый
# реально найденный компонент, ничего не трогает молча.
uninstall_stack() {
  local did_something=0

  if [ -f /etc/systemd/system/autotune-daemon.service ]; then
    read -re -p "Найден autotune-daemon.service — удалить? [y/N]: " ans
    case "$ans" in
      y|Y)
        systemctl disable --now autotune-daemon 2>/dev/null || true
        rm -f /etc/systemd/system/autotune-daemon.service
        systemctl daemon-reload
        echo "autotune-daemon.service удалён."
        did_something=1
        ;;
      *) echo "Пропускаю autotune-daemon.service." ;;
    esac
  else
    echo "autotune-daemon.service не установлен — нечего удалять."
  fi

  echo ""
  if z2r_installed; then
    echo "ВНИМАНИЕ: удаление z2r сотрёт /opt/zapret2 целиком — это само ядро"
    echo "DPI-обхода, а заодно кэш z2r_autobench (locked.tsv, бэкапы) в"
    echo "extra_strats/cache/orchestra. У официального установщика z2r нет"
    echo "известного нам штатного uninstall — удаляем вручную."
    read -re -p "Точно удалить z2r? Наберите 'DELETE' для подтверждения: " ans
    if [ "$ans" = "DELETE" ]; then
      systemctl disable --now zapret2 2>/dev/null || true
      rm -f /usr/lib/systemd/system/zapret2.service /etc/systemd/system/zapret2.service
      systemctl daemon-reload
      rm -rf /opt/zapret2
      echo "z2r удалён."
      did_something=1
    else
      echo "Отмена, z2r не тронут (нужно было ввести именно 'DELETE')."
    fi
  else
    echo "z2r (/opt/zapret2) не найден — нечего удалять."
  fi

  [ "$did_something" = "1" ] || echo "Ничего не удалено."
}

# --- bootstrap: свежескачанный файл (curl -O .../z0r && sh z0r) вне
# /opt/z2r_autobench разворачивает полный автобенч и перезапускается уже
# из установленной копии — тот же трюк, что в установщике z2r (сравнение
# SCRIPT_PATH с BIN_PATH там же). Делаем это ДО диспетчера MODE ниже —
# иначе флаг на самом первом запуске (например "sh z0r --install-service")
# попытался бы выполниться раньше, чем появятся соседние файлы репозитория.
if [ "$SCRIPT_DIR/$(basename -- "${BASH_SOURCE[0]}")" != "$INSTALLED_Z0R" ]; then
  echo "=== Первый запуск (не из $INSTALL_DIR) — разворачиваю z2r_autobench ==="
  if ! z2r_installed; then
    install_z2r || echo "z2r так и не установлен — часть тестов работать не будет, пока не поставишь (пункт 'z' в меню)." >&2
  fi

  if [ -d "$INSTALL_DIR/.git" ] && [ -f "$INSTALLED_Z0R" ]; then
    ( cd "$INSTALL_DIR" && git pull --ff-only origin main >/dev/null 2>&1 ) \
      || echo "GitHub недоступен или есть свои незакоммиченные правки — использую то, что уже есть."
  else
    if ! command -v git >/dev/null 2>&1; then
      echo "git не найден, пробую поставить..." >&2
      apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
      apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
    fi
    if ! command -v git >/dev/null 2>&1; then
      echo "Не удалось поставить git — установи вручную и запусти z0r снова." >&2
      exit 1
    fi
    if ! git clone "$REPO_URL" "$INSTALL_DIR"; then
      echo "Не удалось склонировать z2r_autobench — GitHub недоступен?" >&2
      exit 1
    fi
  fi

  if [ ! -f "$INSTALLED_Z0R" ]; then
    echo "$INSTALLED_Z0R не появился после установки — что-то пошло не так." >&2
    exit 1
  fi
  chmod +x "$INSTALLED_Z0R"

  if [ ! -f /etc/systemd/system/autotune-daemon.service ]; then
    echo ""
    echo "Сервис автотестирования-автоподстройки (autotune-daemon) ещё не установлен."
    read -re -p "Установить и включить его сейчас? [y/N]: " ans
    case "$ans" in
      y|Y) bash "$INSTALLED_Z0R" --install-service ;;
      *) echo "Пропускаю — предложу снова при следующем запуске." ;;
    esac
  fi

  exec bash "$INSTALLED_Z0R" "${ORIG_ARGS[@]}"
fi

# мы точно /opt/z2r_autobench/z0r — обычный (не bootstrap) запуск: тихо
# подтягиваем обновления, если есть доступ к GitHub, и продолжаем как обычно
if [ -d "$INSTALL_DIR/.git" ]; then
  ( cd "$INSTALL_DIR" && git pull --ff-only origin main >/dev/null 2>&1 ) || true
fi

if [ -z "$MODE" ] && ! z2r_installed; then
  echo "z2r (ядро DPI-обхода) не найден в /opt/zapret2." >&2
  echo "Поставь его через пункт 'z' в меню или: sudo ./z0r --install-z2r" >&2
  echo "" >&2
fi

if [ "$MODE" = "all" ]; then
  run_all
  exit 0
fi

if [ "$MODE" = "domain" ]; then
  run_domain_test "$CUSTOM_DOMAIN"
  exit 0
fi

if [ "$MODE" = "single" ]; then
  if [ -z "${TITLES[$SINGLE_PROFILE]:-}" ]; then
    echo "Неизвестный профиль: $SINGLE_PROFILE (доступны: 1-9)" >&2
    exit 1
  fi
  test_profile "$SINGLE_PROFILE"
  exit 0
fi

if [ "$MODE" = "selected" ]; then
  run_selected "$SELECTED_PROFILES"
  exit 0
fi

if [ "$MODE" = "install" ]; then
  install_daemon_service 1
  exit 0
fi

if [ "$MODE" = "install-z2r" ]; then
  install_z2r
  exit $?
fi

if [ "$MODE" = "uninstall" ]; then
  uninstall_stack
  exit 0
fi

# интерактивное меню
while true; do
  choice="$(show_menu)"
  case "$choice" in
    q|Q|"") echo "Выход."; exit 0 ;;
    0) run_all ;;
    1|2|3|4|5|6|7|8|9) test_profile "$choice" ;;
    d|D)
      read -re -p "Домен (например example.com, без https://): " dom
      [ -n "$dom" ] && run_domain_test "$dom"
      ;;
    i|I) install_daemon_service 0 ;;
    z|Z) install_z2r ;;
    u|U) uninstall_stack ;;
    *)
      # список из нескольких профилей: "1,3,4" / "1 3 4" — все токены
      # должны быть известными номерами профилей, иначе это опечатка
      norm="$(echo "$choice" | tr ',' ' ')"
      valid=1
      count=0
      for tok in $norm; do
        count=$((count + 1))
        [ -n "${TITLES[$tok]:-}" ] || valid=0
      done
      if [ "$valid" = "1" ] && [ "$count" -ge 2 ]; then
        run_selected "$choice"
      else
        echo "Некорректный выбор."
      fi
      ;;
  esac
  echo ""
done
