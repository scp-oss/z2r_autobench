# run_logs/ + sudoers для zenith-panel -- вынесено из ветки первого клона
# (case NONE) manage_panel и вызывается ЕЩЁ И безусловно в начале
# manage_panel при каждом заходе в пункт 15, а не только при первой
# установке -- иначе апдейт z0r-скрипта, принёсший новое правило sudoers
# (или починку старого), никогда не долетает до уже установленной панели:
# ON/OFF-ветки только дёргают systemd, старый файл в /etc/sudoers.d/ так
# и остаётся лежать нетронутым. Живой инцидент 2026-08-15: правило чинили
# дважды (сначала write-доступ к run_logs, потом баг в самом sudoers-glob),
# и оба раза пункт 15 -> "ON/OFF" ничего не обновлял, пока это не стало
# отдельной идемпотентной функцией, вызываемой всегда.
ensure_panel_runtime_grants() {
  [ -d "$PANEL_DIR" ] || return 0
  id zenith-panel >/dev/null 2>&1 || return 0

  # см. z0r-panel/runner.py -- панель работает от zenith-panel, а сам
  # $PANEL_DIR обычно принадлежит тому, кто клонировал репозиторий
  # (root/deploy-юзер), не zenith-panel -- без chown os.makedirs() в
  # runner.py падает PermissionError на первом же запуске.
  mkdir -p "$PANEL_DIR/run_logs"
  chown zenith-panel:zenith-panel "$PANEL_DIR/run_logs"

  # Абсолютные пути резолвим тут же -- в sudoers нельзя полагаться на
  # PATH, а хардкодить /usr/bin вслепую рискованно (не везде одинаково).
  local systemctl_bin; systemctl_bin="$(command -v systemctl 2>/dev/null || echo /usr/bin/systemctl)"
  local journalctl_bin; journalctl_bin="$(command -v journalctl 2>/dev/null || echo /usr/bin/journalctl)"
  local flock_bin; flock_bin="$(command -v flock 2>/dev/null || echo /usr/bin/flock)"

  # Sudoers — get/max были принципиально read-only с самого начала (см.
  # README панели "Границы ответственности", то поколение текста). Живой
  # запрос 2026-08-15 изменил это осознанно: /controls теперь умеет и
  # set_strategy_cli.sh set, и restart zapret2 -- то же самое ручное
  # переключение стратегии, что человек делает через z0r пункт 21, просто
  # кнопкой (README/докстринги панели обновлены тем же коммитом).
  local sudoers_set_cmd="/usr/bin/bash $INSTALL_DIR/set_strategy_cli.sh set *"
  # restart -- ОБЯЗАТЕЛЬНЫЙ шаг после set (set_strategy_cli.sh set сам по
  # себе не горячее применение, см. promote.py "circular_locked держит
  # max strategy= в памяти процесса без TTL" -- живой инцидент
  # 2026-08-07). show -- read-only, чтобы панель могла показать
  # ActiveEnterTimestamp и подтвердить, что restart реально произошёл
  # только что, а не тихо не сработал.
  # ДВА отдельных --property=, не один через запятую -- sudoers режет
  # список команд ПО запятой даже внутри аргумента (живой инцидент
  # 2026-08-15: "--property=ActiveEnterTimestamp,SubState" сломало разбор
  # всего файла целиком -- "ожидался полный путь" на "SubState", и как
  # следствие NOPASSWD не применялся вообще ни для одной команды в файле,
  # не только для этой).
  local sudoers_zapret_cmds="$systemctl_bin restart zapret2, $systemctl_bin show zapret2 --property=ActiveEnterTimestamp --property=SubState"

  # Отдельная команда ниже — для кнопки "запустить подбор" на /controls
  # (см. z0r-panel/runner.py): она стартует Zenith'овский
  # orchestrator/main.py от root'а (сам main.py этого требует —
  # песочница, см. Zenith README), но это другая песочница
  # (zenith-sandbox), не боевой zapret2.config — тем не менее это
  # ИСПОЛНЕНИЕ произвольного питон-кода того же main.py, не read-only,
  # так что команда сужена до конкретного venv/main.py с фиксированными
  # флагами, не общий root-шелл.
  # ОДИН завершающий "*", не "* *" -- sudoers-glob матчится против всей
  # командной строки, "* *" требует буквальный пробел + ещё один токен
  # ПОСЛЕ номера раундов, так что без --domain (самый обычный случай --
  # поле в форме необязательное) команда не матчится вообще, sudo -n
  # тихо требует пароль. Один хвостовой "*" матчит и "--rounds 20"
  # (пусто после), и "--rounds 20 --domain host/path" (* жадный).
  # ПОЛНЫЙ путь к main.py, не просто "main.py" -- sudoers матчит команду
  # буквально и понятия не имеет про cwd вызывающего; относительный путь
  # раньше "работал" только потому, что единственный вызывающий
  # (z0r-panel/runner.py) всегда СЛУЧАЙНО ставил правильный cwd перед
  # запуском -- НОПАСВОРД-грант не должен зависеть от этого допущения
  # (найдено при аудите перед деплоем на МТС 2026-08-17, runner.py
  # исправлен тем же коммитом).
  # "flock -n <lock-файл>" ПЕРЕД venv/main.py -- лок держит сам ДОЧЕРНИЙ
  # процесс (не память процесса панели), так что "один прогон
  # одновременно" переживает рестарт панели: второй клик после рестарта,
  # пока старый прогон ещё жив, получает честный отказ от самого flock
  # (найдено при том же аудите, см. z0r-panel/runner.py::RUN_LOCK_FILE).
  local sudoers_run_cmd="$flock_bin -n $ZENITH_DIR/orchestrator/.run.lock $ZENITH_DIR/orchestrator/venv/bin/python3 $ZENITH_DIR/orchestrator/main.py --profile * --rounds *"

  # Старт/стоп/статус/лог autotune-daemon.service с /controls (см.
  # z0r-panel/daemon_ctl.py) -- ровно то же самое, что человек делает
  # руками через пункт 22 -> 5 этого же z0r-скрипта (autotune-daemon --
  # независимый от Zenith механизм, живёт в меню Zenith для удобства, см.
  # CLAUDE.md), просто кнопкой вместо SSH. Команды фиксированы буквально
  # (никаких "*") -- меньше
  # привилегий, чем даже у запуска main.py выше, никакого произвольного
  # выбора юнита или доп. флагов.
  local sudoers_daemon_cmds="$systemctl_bin start autotune-daemon, $systemctl_bin stop autotune-daemon, $systemctl_bin is-active autotune-daemon, $journalctl_bin -u autotune-daemon -n 200 --no-pager"

  # Периодический автозапуск (zenith-autorun.service) и автопродвижение
  # (zenith-promoter.service) БЕЗ участия человека -- ЖИВУТ КАК
  # НЕЗАВИСИМЫЕ systemd-юниты (см. Zenith/README.md "Автономный режим"),
  # НЕ внутри процесса панели -- по прямому запросу "панель это модуль,
  # её может и не быть, функционал должен быть в CLI и без панели".
  # Панель, если установлена, только start/stop/status/log поверх ЭТИХ
  # ЖЕ юнитов (см. z0r-panel/autorun_ctl.py, promoter_ctl.py) -- та же
  # узкая схема, что уже у autotune-daemon выше, никакого прямого
  # доступа к promote_apply_cli.sh/main.py из панели для этой части
  # (тот доступ у панели остаётся ТОЛЬКО для ручных кнопок -- "запустить
  # подбор" разово и "Ручное переключение стратегии", см. выше).
  local sudoers_zenith_units_cmds="$systemctl_bin start zenith-autorun, $systemctl_bin stop zenith-autorun, $systemctl_bin is-active zenith-autorun, $journalctl_bin -u zenith-autorun -n 200 --no-pager, $systemctl_bin start zenith-promoter, $systemctl_bin stop zenith-promoter, $systemctl_bin is-active zenith-promoter, $journalctl_bin -u zenith-promoter -n 200 --no-pager"

  # Автообновление -- панель ТОЛЬКО переключает флаги (autoupdate.sh
  # --set, тот же файл читает/пишет z0r пункт 26) и триггерит разовый
  # прогон/смотрит статус таймера -- саму УСТАНОВКУ таймера (копирование
  # .service/.timer в /etc/systemd/system, daemon-reload) панель делать
  # не должна, это шаг через z0r/SSH, как и первичная установка любого
  # другого юнита в этом файле выше -- панель "пульт" для уже
  # существующего, не устанавливает новое (см. daemon_ctl.py докстринг).
  local sudoers_autoupdate_cmds="/usr/bin/bash $INSTALL_DIR/autoupdate.sh --set *, $systemctl_bin start z2r-autoupdate.service, $systemctl_bin is-enabled z2r-autoupdate.timer, $systemctl_bin is-active z2r-autoupdate.timer, $journalctl_bin -u z2r-autoupdate -n 200 --no-pager"

  local sudoers_file="/etc/sudoers.d/zenith-panel"
  local sudoers_line="zenith-panel ALL=(root) NOPASSWD: /usr/bin/bash $INSTALL_DIR/set_strategy_cli.sh get *, /usr/bin/bash $INSTALL_DIR/set_strategy_cli.sh max *, $sudoers_set_cmd, $sudoers_zapret_cmds, $sudoers_run_cmd, $sudoers_daemon_cmds, $sudoers_zenith_units_cmds, $sudoers_autoupdate_cmds"
  if [ ! -f "$sudoers_file" ] || ! grep -qxF "$sudoers_line" "$sudoers_file" 2>/dev/null; then
    echo "$sudoers_line" > "$sudoers_file"
    chmod 440 "$sudoers_file"
    echo "Добавлен/обновлён $sudoers_file."
  fi
}

manage_panel() {
  local st; st="$(get_panel_status)"
  echo "web_panel: $st"
  ensure_panel_runtime_grants
  case "$st" in
    NONE)
      read -re -p "Склонировать и подготовить z0r-panel в $PANEL_DIR? [y/N]: " ans
      case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

      if ! command -v git >/dev/null 2>&1; then
        echo "git не найден, пробую поставить..." >&2
        apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
        apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
      fi
      if ! git clone "$PANEL_REPO_URL" "$PANEL_DIR"; then
        echo "Не удалось склонировать $PANEL_REPO_URL — GitHub недоступен?" >&2
        return 1
      fi

      if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 не найден, пробую поставить..." >&2
        apt-get install -y python3 python3-venv >/dev/null 2>&1 || opkg install python3 >/dev/null 2>&1 || apk add python3 >/dev/null 2>&1
      fi
      if ! ( cd "$PANEL_DIR" && python3 -m venv venv && venv/bin/pip install -q -r requirements.txt ); then
        echo "Не удалось поставить зависимости панели — доразберись руками в $PANEL_DIR." >&2
        return 1
      fi

      if [ ! -f "$PANEL_DIR/.env" ]; then
        cp "$PANEL_DIR/.env.example" "$PANEL_DIR/.env"
        # Панель ходит в ТУ ЖЕ БД, что и Zenith на этом сервере — если он
        # уже настроен, подхватываем его MYSQL_*/ZENITH_ENVIRONMENT_*
        # вместо повторного ввода тех же значений руками (zenith_env_get
        # читает именно $ZENITH_DIR/.env).
        if [ -f "$ZENITH_DIR/.env" ]; then
          for var in MYSQL_HOST MYSQL_PORT MYSQL_DATABASE MYSQL_USER MYSQL_PASSWORD \
                     ZENITH_ENVIRONMENT_NAME ZENITH_ENVIRONMENT_PROVIDER; do
            val="$(zenith_env_get "$var")"
            [ -n "$val" ] && sed -i "s#^${var}=.*#${var}=${val}#" "$PANEL_DIR/.env"
          done
          echo "Подхватил MYSQL_*/ZENITH_ENVIRONMENT_* из $ZENITH_DIR/.env."
        fi
      fi

      if ! id zenith-panel >/dev/null 2>&1; then
        useradd --system --no-create-home --shell /usr/sbin/nologin zenith-panel
      fi
      ensure_panel_runtime_grants

      echo ""
      echo "Склонирован и готов к настройке. Перед включением (пункт 15 ещё раз):"
      echo "  1. Проверь/заполни: $PANEL_DIR/.env — PANEL_ADMIN_PASSWORD_HASH"
      echo "     ($PANEL_DIR/gen_password_hash.py) и PANEL_SESSION_SECRET"
      echo "     (python3 -c 'import secrets; print(secrets.token_hex(32))')."
      echo "  2. Для доступа снаружи через Cloudflare — см. README панели"
      echo "     \"Публикация через Cloudflare\" (Origin CA сертификат в"
      echo "     $PANEL_DIR/tls/, альт-порт)."
      ;;
    OFF)
      if [ ! -f "/etc/systemd/system/${PANEL_SERVICE}.service" ]; then
        if [ ! -f "$PANEL_DIR/${PANEL_SERVICE}.service" ]; then
          echo "Не найден $PANEL_DIR/${PANEL_SERVICE}.service — что-то не так с чекаутом репозитория." >&2
          return 1
        fi
        cp -f "$PANEL_DIR/${PANEL_SERVICE}.service" "/etc/systemd/system/${PANEL_SERVICE}.service"
        systemctl daemon-reload
      fi
      read -re -p "Сервис установлен, но не запущен. Включить сейчас? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl enable --now "$PANEL_SERVICE"; sleep 2; systemctl status "$PANEL_SERVICE" --no-pager ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
    ON)
      read -re -p "Сервис работает. Остановить и отключить? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl disable --now "$PANEL_SERVICE" 2>/dev/null || true; echo "Остановлен." ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
  esac
}

uninstall_panel() {
  if [ ! -d "$PANEL_DIR" ]; then
    echo "web_panel ($PANEL_DIR) не найден — нечего удалять."
    return 0
  fi
  read -re -p "Найден $PANEL_DIR — остановить сервис и удалить? [y/N]: " ans
  case "$ans" in
    y|Y)
      systemctl disable --now "$PANEL_SERVICE" 2>/dev/null || true
      rm -f "/etc/systemd/system/${PANEL_SERVICE}.service"
      rm -f /etc/sudoers.d/zenith-panel
      systemctl daemon-reload
      rm -rf "$PANEL_DIR"
      echo "web_panel удалён. Юзер zenith-panel не тронут (могут быть его файлы вне $PANEL_DIR) — удали вручную при необходимости: userdel zenith-panel"
      ;;
    *) echo "Отмена, web_panel не тронут." ;;
  esac
}

# Юнит в репозитории Zenith-TG (relay/tg-transparent-relay.service)
# захардкожен на /opt/Zenith-TG (так был вручную развёрнут и проверен
# на первом сервере) — z0r клонирует в $TGRELAY_DIR (=$INSTALL_DIR/
# Zenith-TG, по общей конвенции этого файла), путь может не совпадать,
# поэтому подставляем реальный $TGRELAY_DIR при копировании юнита, а не
# копируем как есть (см. manage_panel — там копия 1:1, т.к. её юнит уже
# ссылается на $PANEL_DIR по той же конвенции).
manage_tg_relay() {
  local st; st="$(get_tg_relay_status)"
  echo "Zenith-TG (Telegram relay): $st"
  case "$st" in
    NONE)
      read -re -p "Склонировать и подготовить Zenith-TG в $TGRELAY_DIR? [y/N]: " ans
      case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

      if ! command -v git >/dev/null 2>&1; then
        echo "git не найден, пробую поставить..." >&2
        apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
        apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
      fi
      if ! git clone "$TGRELAY_REPO_URL" "$TGRELAY_DIR"; then
        echo "Не удалось склонировать $TGRELAY_REPO_URL — GitHub недоступен?" >&2
        return 1
      fi

      if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 не найден, пробую поставить..." >&2
        apt-get install -y python3 python3-venv >/dev/null 2>&1 || opkg install python3 >/dev/null 2>&1 || apk add python3 >/dev/null 2>&1
      fi
      if ! ( cd "$TGRELAY_DIR" && python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt ); then
        echo "Не удалось поставить зависимости relay — доразберись руками в $TGRELAY_DIR." >&2
        return 1
      fi

      if ! bash "$TGRELAY_DIR/cidr/fetch_telegram_cidr.sh"; then
        echo "Не удалось получить список подсетей Telegram — доразберись руками (cidr/fetch_telegram_cidr.sh) перед включением." >&2
        return 1
      fi

      if ! id tgrelay >/dev/null 2>&1; then
        useradd --system --no-create-home --shell /usr/sbin/nologin tgrelay
      fi
      chown -R tgrelay:tgrelay "$TGRELAY_DIR"

      echo ""
      echo "Склонирован и готов. Включи сейчас же (пункт ещё раз) — при включении"
      echo "поднимется сервис И встанет прозрачный iptables REDIRECT на подсети"
      echo "Telegram (см. README репозитория, 'Что требует внимания при эксплуатации')."
      ;;
    OFF)
      if [ ! -f "/etc/systemd/system/${TGRELAY_SERVICE}.service" ]; then
        if [ ! -f "$TGRELAY_DIR/relay/${TGRELAY_SERVICE}.service" ]; then
          echo "Не найден $TGRELAY_DIR/relay/${TGRELAY_SERVICE}.service — что-то не так с чекаутом репозитория." >&2
          return 1
        fi
        sed -e "s#/opt/Zenith-TG/relay#${TGRELAY_DIR}/relay#g" \
            -e "s#/opt/Zenith-TG/\.venv#${TGRELAY_DIR}/.venv#g" \
            "$TGRELAY_DIR/relay/${TGRELAY_SERVICE}.service" \
            > "/etc/systemd/system/${TGRELAY_SERVICE}.service"
        systemctl daemon-reload
      fi
      read -re -p "Сервис установлен, но не запущен. Включить сейчас (сервис + REDIRECT)? [y/N]: " ans
      case "$ans" in
        y|Y)
          systemctl enable --now "$TGRELAY_SERVICE"
          sleep 2
          systemctl status "$TGRELAY_SERVICE" --no-pager
          if bash "$TGRELAY_DIR/relay/setup_redirect.sh" apply; then
            echo "REDIRECT применён — трафик к подсетям Telegram (443) теперь идёт через relay."
          else
            echo "Не удалось применить REDIRECT — сервис работает, но трафик пока не перенаправлен (доразберись руками: $TGRELAY_DIR/relay/setup_redirect.sh apply)." >&2
          fi
          ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
    ON)
      read -re -p "Сервис работает. Остановить, отключить и снять REDIRECT? [y/N]: " ans
      case "$ans" in
        y|Y)
          bash "$TGRELAY_DIR/relay/setup_redirect.sh" remove 2>/dev/null || true
          systemctl disable --now "$TGRELAY_SERVICE" 2>/dev/null || true
          echo "Остановлен, REDIRECT снят."
          ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
  esac
}

uninstall_tg_relay() {
  if [ ! -d "$TGRELAY_DIR" ]; then
    echo "Zenith-TG ($TGRELAY_DIR) не найден — нечего удалять."
    return 0
  fi
  read -re -p "Найден $TGRELAY_DIR — снять REDIRECT, остановить сервис и удалить? [y/N]: " ans
  case "$ans" in
    y|Y)
      bash "$TGRELAY_DIR/relay/setup_redirect.sh" remove 2>/dev/null || true
      systemctl disable --now "$TGRELAY_SERVICE" 2>/dev/null || true
      rm -f "/etc/systemd/system/${TGRELAY_SERVICE}.service"
      systemctl daemon-reload
      rm -rf "$TGRELAY_DIR"
      echo "Zenith-TG удалён. Юзер tgrelay не тронут — удали вручную при необходимости: userdel tgrelay"
      ;;
    *) echo "Отмена, Zenith-TG не тронут." ;;
  esac
}

# Реальный слушающий адрес пакета Debian -- 127.0.2.1 (не 127.0.0.1, чтобы
# не конфликтовать с типичным использованием последнего другими
# резолверами), но не хардкодим -- вдруг другой дистрибутив/версия даст
# другой дефолт. Фолбэк на 127.0.2.1, если распарсить не удалось.
dnscrypt_listen_addr() {
  local line addr
  line="$(grep -E '^\s*listen_addresses' "$DNSCRYPT_TOML" 2>/dev/null | head -1)"
  addr="$(echo "$line" | grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' | head -1)"
  echo "${addr:-127.0.2.1}"
}

# Прописывает локальный резолвер в системный DNS. Знаем только про dhcpcd
# (единственная реально встреченная схема пока) -- для остального просто
# подсказываем адрес и не лезем гадать формат чужого сетевого менеджера.
# Метка $DNSCRYPT_DHCPCD_MARKER нужна, чтобы uninstall_dnscrypt() снял
# ТОЛЬКО то, что добавили сами, не трогая чужие static-записи.
dnscrypt_wire_resolver() {
  local addr="$1" iface
  if ! command -v dhcpcd >/dev/null 2>&1 || ! pgrep -x dhcpcd >/dev/null 2>&1; then
    echo "Не нашёл dhcpcd -- пропиши резолвер ($addr) вручную в своей сетевой конфигурации (systemd-resolved/NetworkManager/interfaces/etc)." >&2
    return 1
  fi
  if grep -qF "$DNSCRYPT_DHCPCD_MARKER" /etc/dhcpcd.conf 2>/dev/null; then
    echo "dhcpcd уже настроен на локальный резолвер (запись z0r-dnscrypt уже есть) -- не трогаю."
    return 0
  fi
  {
    echo "$DNSCRYPT_DHCPCD_MARKER"
    echo "static domain_name_servers=${addr}"
  } >> /etc/dhcpcd.conf
  iface="$(ip -4 route show default 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}' | head -1)"
  if [ -n "$iface" ]; then
    dhcpcd -n "$iface" >/dev/null 2>&1
    echo "Системный DNS переключён на $addr (через dhcpcd, интерфейс $iface)."
  else
    echo "Запись добавлена, но не удалось определить интерфейс -- примени вручную: dhcpcd -n <интерфейс>." >&2
  fi
}

install_dnscrypt() {
  if ! command -v dnscrypt-proxy >/dev/null 2>&1; then
    apt-get update >/dev/null 2>&1
    apt-get install -y dnscrypt-proxy >/dev/null 2>&1 \
      || opkg install dnscrypt-proxy >/dev/null 2>&1 \
      || apk add dnscrypt-proxy >/dev/null 2>&1
  fi
  if ! command -v dnscrypt-proxy >/dev/null 2>&1; then
    echo "Не удалось поставить dnscrypt-proxy автоматически -- поставь пакет вручную и повтори." >&2
    return 1
  fi
  if [ -f "$DNSCRYPT_TOML" ]; then
    sed -i "s/^#\?[[:space:]]*server_names[[:space:]]*=.*/${DNSCRYPT_SERVER_NAMES}/" "$DNSCRYPT_TOML"
  fi
  systemctl enable --now dnscrypt-proxy.socket >/dev/null 2>&1
  systemctl restart dnscrypt-proxy
  sleep 1
  echo "dnscrypt-proxy установлен и запущен (server_names: cloudflare, cloudflare-ipv6, nextdns, sb)."
}

manage_dnscrypt() {
  local st; st="$(get_dnscrypt_status)"
  echo "DNSCrypt-proxy (локальный DoH-резолвер): $st"
  case "$st" in
    NONE)
      echo "Полезно, когда провайдер режет обычный DNS/DoT/DoH к популярным резолверам"
      echo "(живой случай 2026-08-22: youtube.com отдавал NXDOMAIN даже через 8.8.8.8,"
      echo "но резолвился нормально через DoH к cloudflare-dns.com/dns.nextdns.io/dns.sb)."
      read -re -p "Поставить и настроить dnscrypt-proxy? [y/N]: " ans
      case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac
      install_dnscrypt || return 1
      local addr; addr="$(dnscrypt_listen_addr)"
      if command -v dig >/dev/null 2>&1; then
        echo "Проверка: dig @$addr youtube.com +short"
        dig "@$addr" youtube.com +short
      fi
      read -re -p "Переключить системный DNS на локальный резолвер ($addr) прямо сейчас? [y/N]: " ans2
      case "$ans2" in
        y|Y) dnscrypt_wire_resolver "$addr" ;;
        *) echo "Ок, резолвер поднят на $addr, но система пока на старом DNS -- переключи вручную, когда будешь готов (или зайди в этот пункт ещё раз)." ;;
      esac
      ;;
    OFF)
      read -re -p "Сервис остановлен. Запустить? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl enable --now dnscrypt-proxy.socket dnscrypt-proxy >/dev/null 2>&1; echo "Запущен." ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
    ON)
      read -re -p "Сервис работает. Остановить? [y/N]: " ans
      case "$ans" in
        y|Y)
          systemctl disable --now dnscrypt-proxy dnscrypt-proxy.socket >/dev/null 2>&1
          echo "Остановлен (пакет и переключение системного DNS не тронуты -- пункт удаления снимает полностью)."
          ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
  esac
}

uninstall_dnscrypt() {
  if ! command -v dnscrypt-proxy >/dev/null 2>&1; then
    echo "dnscrypt-proxy не установлен -- нечего удалять."
    return 0
  fi
  read -re -p "Остановить, снять переключение DNS (если делали через z0r) и удалить пакет dnscrypt-proxy? [y/N]: " ans
  case "$ans" in
    y|Y)
      systemctl disable --now dnscrypt-proxy dnscrypt-proxy.socket >/dev/null 2>&1 || true
      if grep -qF "$DNSCRYPT_DHCPCD_MARKER" /etc/dhcpcd.conf 2>/dev/null; then
        # awk, не sed -- маркер содержит "#" и скобки, которые ломают
        # sed-паттерн при использовании как разделителя/regex. Точное
        # строковое сравнение через -v убирает саму строку-маркер и
        # ровно одну следующую (нашу static domain_name_servers=...).
        awk -v marker="$DNSCRYPT_DHCPCD_MARKER" '
          $0 == marker { skip = 2; next }
          skip > 0 { skip--; next }
          { print }
        ' /etc/dhcpcd.conf > /etc/dhcpcd.conf.z0r-tmp && mv /etc/dhcpcd.conf.z0r-tmp /etc/dhcpcd.conf
        local iface; iface="$(ip -4 route show default 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}' | head -1)"
        [ -n "$iface" ] && dhcpcd -n "$iface" >/dev/null 2>&1
        echo "Запись переключения DNS в dhcpcd.conf снята, интерфейс перечитал конфиг."
      fi
      apt-get remove -y dnscrypt-proxy >/dev/null 2>&1 \
        || opkg remove dnscrypt-proxy >/dev/null 2>&1 \
        || apk del dnscrypt-proxy >/dev/null 2>&1
      echo "dnscrypt-proxy удалён."
      ;;
    *) echo "Отмена, dnscrypt-proxy не тронут." ;;
  esac
}

# Удаляет весь z2r_autobench (сам себя) — файл, из которого мы прямо сейчас
# исполняемся, тоже пропадёт, поэтому сразу выходим после rm -rf, ничего
# больше из скрипта не трогаем. z2r, autotune-daemon.service и Discord_bot
# НЕ трогает — для них отдельные пункты (16/17/18), чтобы не сносить
# что-то по ошибке заодно.
# Ставит команду "z0r" в PATH (симлинк на $INSTALLED_Z0R), чтобы можно было
# звать из любого каталога, как и родной "z2r" (тот себя ставит в
# /usr/local/bin/z2r сам, см. установщик автора). Идемпотентно — если
# симлинк уже правильный, молчит; если там что-то постороннее с этим же
# именем (не наш симлинк) — не трогает и предупреждает.
ensure_z0r_command() {
  [ -f "$INSTALLED_Z0R" ] || return 0
  if [ -L "$Z0R_BIN_LINK" ]; then
    [ "$(readlink -f "$Z0R_BIN_LINK" 2>/dev/null)" = "$(readlink -f "$INSTALLED_Z0R" 2>/dev/null)" ] && return 0
    echo "$Z0R_BIN_LINK уже ведёт куда-то ещё — не трогаю." >&2
    return 0
  fi
  if [ -e "$Z0R_BIN_LINK" ]; then
    echo "$Z0R_BIN_LINK уже существует и это не симлинк — не трогаю." >&2
    return 0
  fi
  ln -s "$INSTALLED_Z0R" "$Z0R_BIN_LINK" 2>/dev/null \
    && echo "Команда 'z0r' установлена ($Z0R_BIN_LINK -> $INSTALLED_Z0R)."
}

uninstall_autobench_self() {
  echo "ВНИМАНИЕ: удалит весь $INSTALL_DIR — сам этот инструмент и все его файлы"
  echo "(включая логи тестов и Discord_bot внутри него, если он тут склонирован)."
  echo "z2r и autotune-daemon.service не тронет — это отдельные пункты (16/17)."
  read -re -p "Точно удалить z2r_autobench? Наберите 'DELETE' для подтверждения: " ans
  if [ "$ans" = "DELETE" ]; then
    echo "Удаляю $INSTALL_DIR..."
    if [ -L "$Z0R_BIN_LINK" ] && [ "$(readlink -f "$Z0R_BIN_LINK" 2>/dev/null)" = "$(readlink -f "$INSTALLED_Z0R" 2>/dev/null)" ]; then
      rm -f "$Z0R_BIN_LINK"
      echo "Команда 'z0r' ($Z0R_BIN_LINK) удалена."
    fi
    rm -rf "$INSTALL_DIR"
    echo "z2r_autobench удалён."
    exit 0
  else
    echo "Отмена, z2r_autobench не тронут (нужно было ввести именно 'DELETE')."
  fi
}

# Оставлен для --uninstall (CLI-флаг, без меню) — спрашивает про оба
# компонента по очереди, как и раньше.
uninstall_stack() {
  uninstall_daemon
  echo ""
  uninstall_z2r
}

# Пункт меню 999 — пройтись по всем компонентам подряд (демон, z2r,
# Discord_bot, сам автобенч), каждый со своим подтверждением.
# uninstall_autobench_self сам завершает процесс (exit), поэтому его
# вызываем последним.
uninstall_everything() {
  uninstall_daemon
  echo ""
  uninstall_z2r
  echo ""
  uninstall_voice_bot
  echo ""
  uninstall_panel
  echo ""
  uninstall_zenith
  echo ""
  uninstall_tg_relay
  echo ""
  uninstall_dnscrypt
  echo ""
  uninstall_autobench_self
}

# --- bootstrap: свежескачанный файл (curl -O .../z0r && sh z0r) вне
# /opt/z2r_autobench разворачивает полный автобенч и перезапускается уже
# из установленной копии — тот же трюк, что в установщике z2r (сравнение
# SCRIPT_PATH с BIN_PATH там же). Делаем это ДО диспетчера MODE ниже —
# иначе флаг на самом первом запуске (например "sh z0r --install-service")
# попытался бы выполниться раньше, чем появятся соседние файлы репозитория.
if [ "$SCRIPT_DIR/$(basename -- "${BASH_SOURCE[0]}")" != "$INSTALLED_Z0R" ]; then
  echo "=== Первый запуск (не из $INSTALL_DIR) — разворачиваю z2r_autobench ==="
  if ! z2r_installed; then
    install_z2r || echo "z2r так и не установлен — часть тестов работать не будет, пока не поставишь (пункт 12 в меню)." >&2
  fi

  if [ -d "$INSTALL_DIR/.git" ] && [ -f "$INSTALLED_Z0R" ]; then
    ( cd "$INSTALL_DIR" && git pull --ff-only origin main >/dev/null 2>&1 ) \
      || echo "GitHub недоступен или есть свои незакоммиченные правки — использую то, что уже есть."
  else
    if ! command -v git >/dev/null 2>&1; then
      echo "git не найден, пробую поставить..." >&2
      apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
      apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
    fi
    if ! command -v git >/dev/null 2>&1; then
      echo "Не удалось поставить git — установи вручную и запусти z0r снова." >&2
      exit 1
    fi
    if ! git clone "$REPO_URL" "$INSTALL_DIR"; then
      echo "Не удалось склонировать z2r_autobench — GitHub недоступен?" >&2
      exit 1
    fi
  fi

  if [ ! -f "$INSTALLED_Z0R" ]; then
    echo "$INSTALLED_Z0R не появился после установки — что-то пошло не так." >&2
    exit 1
  fi
  chmod +x "$INSTALLED_Z0R"
  ensure_z0r_command

  if [ ! -f /etc/systemd/system/autotune-daemon.service ]; then
    echo ""
    echo "Сервис автотестирования-автоподстройки (autotune-daemon) ещё не установлен."
    read -re -p "Установить и включить его сейчас? [y/N]: " ans
    case "$ans" in
      y|Y) bash "$INSTALLED_Z0R" --install-service ;;
      *) echo "Пропускаю — предложу снова при следующем запуске." ;;
    esac
  fi

  exec bash "$INSTALLED_Z0R" "${ORIG_ARGS[@]}"
fi

# мы точно /opt/z2r_autobench/z0r — обычный (не bootstrap) запуск: тихо
# подтягиваем обновления, если есть доступ к GitHub, и продолжаем как обычно
ensure_z0r_command
if [ -d "$INSTALL_DIR/.git" ]; then
  ( cd "$INSTALL_DIR" && git pull --ff-only origin main >/dev/null 2>&1 ) || true
fi

if [ -z "$MODE" ] && ! z2r_installed; then
  echo "z2r (ядро DPI-обхода) не найден в /opt/zapret2." >&2
  echo "Поставь его через пункт 12 в меню или: sudo ./z0r --install-z2r" >&2
  echo "" >&2
fi

if [ "$MODE" = "all" ]; then
  run_all
  exit 0
fi

if [ "$MODE" = "domain" ]; then
  run_domain_test "$CUSTOM_DOMAIN"
  exit 0
fi

if [ "$MODE" = "single" ]; then
  if [ -z "${TITLES[$SINGLE_PROFILE]:-}" ]; then
    echo "Неизвестный профиль: $SINGLE_PROFILE (доступны: 1-9)" >&2
    exit 1
  fi
  test_profile "$SINGLE_PROFILE"
  exit 0
fi

if [ "$MODE" = "selected" ]; then
  run_selected "$SELECTED_PROFILES"
  exit 0
fi

if [ "$MODE" = "install" ]; then
  install_daemon_service 1
  exit 0
fi

if [ "$MODE" = "install-z2r" ]; then
  install_z2r
  exit $?
fi

if [ "$MODE" = "install-z2r-offline" ]; then
  install_z2r_offline
  exit $?
fi

if [ "$MODE" = "uninstall" ]; then
  uninstall_stack
  exit 0
fi

# интерактивное меню
while true; do
  choice="$(show_menu)"
  case "$choice" in
    q|Q|0|"") echo "Выход."; exit 0 ;;
    111) run_all ;;
    1|2|3|4|5|6|7|8|9) test_profile "$choice" ;;
    10)
      read -re -p "Домен (например example.com, без https://): " dom
      [ -n "$dom" ] && run_domain_test "$dom"
      ;;
    27)
      read -re -p "Стратегии через запятую для сравнения (Enter — только текущая): " strats
      read -re -p "Сколько шортсов подряд (Enter — по умолчанию, 8): " cnt
      run_shorts_test "$strats" "$cnt"
      ;;
    11) launch_z2r ;;
    21) manual_switch_strategy ;;
    12) manage_zapret ;;
    14) manage_voice_bot ;;
    15) manage_panel ;;
    16) uninstall_z2r ;;
    17) uninstall_daemon ;;
    18) uninstall_voice_bot ;;
    19) uninstall_panel ;;
    20) uninstall_autobench_self ;;
    22) manage_zenith ;;
    23) uninstall_zenith ;;
    24) manage_tg_relay ;;
    25) uninstall_tg_relay ;;
    26) autoupdate_menu ;;
    28) manage_dnscrypt ;;
    29) uninstall_dnscrypt ;;
    999) uninstall_everything ;;
    *)
      # список из нескольких профилей: "1,3,4" / "1 3 4" — все токены
      # должны быть известными номерами профилей, иначе это опечатка
      norm="$(echo "$choice" | tr ',' ' ')"
      valid=1
      count=0
      for tok in $norm; do
        count=$((count + 1))
        [ -n "${TITLES[$tok]:-}" ] || valid=0
      done
      if [ "$valid" = "1" ] && [ "$count" -ge 2 ]; then
        run_selected "$choice"
      else
        echo "Некорректный выбор."
      fi
      ;;
  esac
  echo ""
done
