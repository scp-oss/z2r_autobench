# shorts_probe.sh — только диагностика (см. докстринг самого скрипта),
# ничего не устанавливает/не удаляет отдельно (в отличие от Zenith/
# Zenith-TG/Discord_bot) — это простой скрипт внутри z2r_autobench,
# приезжает вместе с ним через обычный git pull/автообновление, отдельного
# жизненного цикла как у сервисов у него нет.
run_shorts_test() {
  local strategies="${1:-}" count="${2:-}"
  echo "--- Тест YouTube Shorts (профиль 2/GV_TLS, паттерн быстрой подгрузки) ---"
  local args=()
  [ -n "$strategies" ] && args+=(--strategies "$strategies")
  [ -n "$count" ] && args+=(--count "$count")
  bash "$SCRIPT_DIR/shorts_probe.sh" "${args[@]}"
}

# Выборочный прогон набора профилей: "1,3,4" или "1 3 4"
run_selected() {
  local raw="$1" ids auto_ids pid
  ids="$(echo "$raw" | tr ',' ' ')"
  # Если среди запрошенных есть зависящий профиль (2 и/или 5), а его
  # зависимость (1) сама не запрошена — добавляем её первой в очередь,
  # иначе тест зависящего профиля будет проверять не то, что применят.
  ids="$(expand_with_deps "$ids")"
  auto_ids="$(compute_auto_ids "$ids")"
  if [ -n "$(echo "$auto_ids" | tr -d ' ')" ]; then
    echo "Профил(и) [$auto_ids] — зависимость для другого запрошенного профиля, тестируется первым и применяется без вопроса."
  fi

  echo "=== Выборочный прогон профилей: $ids ($PASSES проход(ов) на TLS/QUIC) ==="
  echo ""
  for pid in $ids; do
    if [ -z "${TITLES[$pid]:-}" ]; then
      echo "Пропускаю неизвестный профиль: $pid" >&2
      continue
    fi
    test_profile "$pid"
    echo ""
    case " $auto_ids " in
      *" $pid "*) apply_best_auto "$pid" ;;
      *) offer_apply_best "$pid" ;;
    esac
    echo ""
  done

  echo "=== ИТОГ (выборочно) ==="
  for pid in $ids; do
    [ -n "${TITLES[$pid]:-}" ] || continue
    if [ "$pid" = "7" ]; then
      echo "$pid ${TITLES[$pid]}: тестер не реализован (сделаем позже)"
      continue
    fi
    local ordered
    ordered="$(read_last_ordered "$pid")"
    echo "$pid ${TITLES[$pid]}: ${ordered:-нет данных}"
  done
}

# Установить и (по желанию) включить autotune-daemon.service — фоновый демон,
# который сам тестирует профили по health-check-триггеру и подставляет лучшую
# стратегию в locked.tsv/profile.lock (см. autotune_daemon.sh). $1=1 —
# без интерактивного вопроса сразу enable --now (для --install-service).
install_daemon_service() {
  local noninteractive="${1:-0}"
  local unit_src="$SCRIPT_DIR/autotune-daemon.service"
  local unit_dst="/etc/systemd/system/autotune-daemon.service"

  if [ ! -f "$unit_src" ]; then
    echo "Не найден $unit_src — что-то не так с чекаутом репозитория." >&2
    return 1
  fi

  echo "Устанавливаю $unit_dst <- $unit_src"
  cp -f "$unit_src" "$unit_dst"
  systemctl daemon-reload

  echo ""
  echo "Проверка внешних зависимостей (демон и сам это проверяет в рантайме и"
  echo "временно пропускает соответствующие профили, если чего-то нет — но"
  echo "лучше знать заранее):"
  if command -v yt-dlp >/dev/null 2>&1; then
    echo "  yt-dlp: OK ($(yt-dlp --version 2>/dev/null))"
  else
    echo "  yt-dlp: НЕ НАЙДЕН — профили 2 (GV_TLS) и 5 (YT_QUIC_UDP) будут временно пропущены."
    echo "          Установи: pip install yt-dlp --break-system-packages"
  fi
  if python3 -c "import aioquic" >/dev/null 2>&1; then
    echo "  aioquic: OK"
  else
    echo "  aioquic: НЕ НАЙДЕН — профиль 5 (YT_QUIC_UDP) будет временно пропущен."
    echo "           Установи: pip install aioquic --break-system-packages"
  fi
  echo ""

  if [ "$noninteractive" = "1" ]; then
    systemctl enable --now autotune-daemon
    sleep 2
    systemctl status autotune-daemon --no-pager
    return 0
  fi

  read -re -p "Включить и запустить autotune-daemon.service сейчас? [Y/n]: " ans
  case "$ans" in
    n|N) echo "Юнит установлен, но не запущен. Запустить вручную: systemctl enable --now autotune-daemon" ;;
    *)
      systemctl enable --now autotune-daemon
      sleep 2
      systemctl status autotune-daemon --no-pager
      ;;
  esac
}

# z2r (ядро DPI-обхода) ставится собственным установщиком автора, не нашим
# кодом — мы только определяем, стоит ли он, и по запросу скачиваем/запускаем
# тот же установщик, которым обычно ставят z2r руками.
z2r_installed() {
  [ -d /opt/zapret2 ] && [ -x /opt/zapret2/init.d/sysv/zapret2 ]
}

ensure_curl() {
  command -v curl >/dev/null 2>&1 && return 0
  echo "curl не найден, пробую поставить..." >&2
  apt update || opkg update || apk update && apt install curl || opkg install curl || apk add curl
  command -v curl >/dev/null 2>&1
}

# python3 -m venv может молча "создаться" без рабочего pip внутри --
# ensurepip не всегда идёт частью базового python3 (Debian/Ubuntu держат
# его в ОТДЕЛЬНОМ пакете, версионном -- python3.13-venv, не только общем
# python3-venv). Живой случай на Ростелекоме 2026-08-13: venv создался,
# первый же venv/bin/pip install упал с "ensurepip is not available" --
# узнаём это ДО того, как что-то реально понадобится ставить, а не
# посреди установки Zenith.
ensure_python_venv() {
  local test_dir ok=0
  test_dir="$(mktemp -d)"
  if python3 -m venv "$test_dir/venv" >/dev/null 2>&1 && [ -x "$test_dir/venv/bin/pip" ]; then
    ok=1
  fi
  rm -rf "$test_dir"
  [ "$ok" = "1" ] && return 0

  echo "python3 -m venv не даёт рабочий pip, ставлю пакет venv..." >&2
  local pyver; pyver="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)"
  apt-get install -y python3-venv >/dev/null 2>&1
  [ -n "$pyver" ] && apt-get install -y "python${pyver}-venv" >/dev/null 2>&1
  opkg install python3-venv >/dev/null 2>&1

  test_dir="$(mktemp -d)"
  python3 -m venv "$test_dir/venv" >/dev/null 2>&1 && [ -x "$test_dir/venv/bin/pip" ]
  ok=$?
  rm -rf "$test_dir"
  return $ok
}

# Живой случай на Ростелекоме 2026-08-13: локальный DNS для
# raw.githubusercontent.com вернул ВМЕСТЕ с настоящими IP (185.199.10x.133,
# Fastly) чужой 1.1.1.1 (адрес резолвера Cloudflare, не хостинга GitHub
# Pages) -- явная подмена ответа, не просто "домен недоступен". Собственная
# DoH-проверка авторского установщика z2r тоже не помогла ("Не удалось
# получить IP через DoH") -- сам dns.google был недоступен с этой же сети,
# так что ОДНОРАЗОВАЯ проверка внутри install_z2r() ничего не чинит сама
# по себе, но стоит явно предложить постоянный DoT-резолвер (не только для
# GitHub-доменов -- если ISP подменяет DNS для одного хоста, подозревать
# стоит и остальные).
# DoH-запрос к конкретному провайдеру. Google и Cloudflare оба отдают
# JSON, но у Cloudflare без заголовка Accept: application/dns-json уходит
# в DNS-wire-формат вместо JSON -- отсюда разные curl-вызовы, не общий.
# Яндекс сюда намеренно не включён -- их JSON DoH-эндпоинт не проверен
# вживую (в отличие от DoT ниже в offer_doh_setup, тот документирован
# надёжно), гадать не хочется.
_doh_query_google() {
  curl -fsS --max-time 5 "https://dns.google/resolve?name=${1}&type=A" 2>/dev/null
}
_doh_query_cloudflare() {
  curl -fsS --max-time 5 -H 'accept: application/dns-json' \
    "https://cloudflare-dns.com/dns-query?name=${1}&type=A" 2>/dev/null
}

dns_looks_hijacked() {
  local domain="$1" local_ips doh_ips extra provider raw
  local_ips="$(getent hosts "$domain" 2>/dev/null | awk '{print $1}' | sort -u)"
  [ -z "$local_ips" ] && return 1

  doh_ips=""
  for provider in _doh_query_google _doh_query_cloudflare; do
    raw="$("$provider" "$domain")"
    [ -z "$raw" ] && continue
    doh_ips="$(printf '%s' "$raw" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for a in data.get('Answer', []):
    if a.get('type') == 1:
        print(a['data'])
" 2>/dev/null | sort -u)"
    [ -n "$doh_ips" ] && break
  done
  [ -z "$doh_ips" ] && return 1

  # Хоть один локальный IP, которого DoH не подтверждает -- подозрение на подмену
  extra="$(comm -23 <(printf '%s\n' "$local_ips") <(printf '%s\n' "$doh_ips"))"
  [ -n "$extra" ]
}

# Ставит DNS-over-TLS через systemd-resolved (drop-in, не трогает основной
# resolved.conf напрямую -- откатывается одним rm) -- самый низкий порог
# входа на Debian/Ubuntu (systemd-resolved обычно уже есть, отдельный демон
# ставить не нужно). На системах без systemd-resolved просто печатает,
# что делать руками -- не тащим сюда dnscrypt-proxy/cloudflared ради
# одной проверки.
offer_doh_setup() {
  echo "Похоже, локальный DNS у этого провайдера подменяет ответы (см. вывод выше)." >&2
  if ! command -v systemctl >/dev/null 2>&1 || ! systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1; then
    echo "systemd-resolved не найден -- настрой DoH/DoT-резолвер вручную (например," >&2
    echo "dnscrypt-proxy) и перезапусти установку." >&2
    return 1
  fi
  read -re -p "Включить DNS-over-TLS через systemd-resolved (Cloudflare/Quad9/Яндекс, шифрованно, ISP не подменит)? [Y/n]: " ans
  case "$ans" in n|N) return 1 ;; esac

  # Три независимых DoT-провайдера -- если один из них у конкретного ISP
  # тоже режется (см. CLAUDE.md/README про то, что провайдеры периодически
  # блокируют отдельные диапазоны), systemd-resolved сам переберёт
  # остальные. Яндекс -- common.dot.dns.yandex.net (не "безопасный"/
  # "семейный" вариант, тот дополнительно фильтрует некоторые домены,
  # нам нужен обычный).
  mkdir -p /etc/systemd/resolved.conf.d
  cat > /etc/systemd/resolved.conf.d/z0r-doh.conf <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 9.9.9.9#dns.quad9.net 77.88.8.8#common.dot.dns.yandex.net
DNSOverTLS=yes
EOF
  systemctl restart systemd-resolved
  echo "Готово -- /etc/systemd/resolved.conf.d/z0r-doh.conf (откат: rm его и systemctl restart systemd-resolved)."
  return 0
}

ensure_expect() {
  command -v expect >/dev/null 2>&1 && return 0
  echo "expect не найден, пробую поставить..." >&2
  apt-get install -y expect >/dev/null 2>&1 || opkg install expect >/dev/null 2>&1
  command -v expect >/dev/null 2>&1
}

# Авторский установщик z2r (не наш код) задаёт ~10 интерактивных вопросов
# подряд -- почти у всех есть разумный дефолт по Enter, кроме выбора
# firewall (дефолт автора -- nftables, тут по прямому запросу нужен
# iptables) и выбора LAN/WAN интерфейса (списка без дефолта, номер плывёт
# от машины к машине из-за docker-мостов/veth). Гоняем тот же `sh z2r`
# через expect и сами отвечаем по тексту вопроса -- для интерфейса
# парсим уже напечатанный список (лежит в $expect_out(buffer) на момент
# совпадения с промптом) и ищем строку с именем интерфейса дефолтного
# маршрута.
#
# Если формулировка вопроса у автора когда-нибудь поменяется -- конкретный
# expect-шаблон просто не совпадёт и шаг провиснет на 30-секундном таймауте
# (не отправит случайный неверный ответ), тогда откат -- обычная
# интерактивная установка (install_z2r/install_z2r_offline).
#
# $1 -- путь к скачанному файлу z2r (не обязательно в текущей директории).
run_z2r_installer_unattended() {
  local z2r_path="$1" dir base
  dir="$(dirname "$z2r_path")"; base="$(basename "$z2r_path")"

  if ! ensure_expect; then
    echo "expect не поставился -- обычная интерактивная установка." >&2
    ( cd "$dir" && sh "$base" )
    return $?
  fi

  local iface
  iface="$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}' | head -1)"
  [ -z "$iface" ] && iface="$(ip -6 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="dev") print $(i+1)}' | head -1)"

  ( cd "$dir" && IFACE="$iface" Z2R_BASE="$base" expect -c '
    encoding system utf-8
    set timeout 30
    set iface $env(IFACE)
    spawn sh $env(Z2R_BASE)

    expect {
      "или Enter для пропуска" { send "\r"; exp_continue }
      "web-ssh)? Enter - Да, 1 - нет" { send "\r"; exp_continue }
      "your choice (default : nftables) :" { send "1\r"; exp_continue }
      "ipv6 support" { send "\r"; exp_continue }
      "your choice (default : hostlist) :" { send "\r"; exp_continue }
      "enable nfqws2 ?" { send "\r"; exp_continue }
      "edit the options" { send "\r"; exp_continue }
      -re {your choice \(default : NONE\) : $} {
        if {$iface ne "" && [regexp -line "^\\s*(\\d+) : $iface\\y" $expect_out(buffer) matched num]} {
          send "$num\r"
        } else {
          send "\r"
        }
        exp_continue
      }
      -re {your choice \(default : ANY\) : $} {
        if {$iface ne "" && [regexp -line "^\\s*(\\d+) : $iface\\y" $expect_out(buffer) matched num]} {
          send "$num\r"
        } else {
          send "\r"
        }
        exp_continue
      }
      "auto download ip/host list" { send "\r"; exp_continue }
      "~3мб места)? 1 - Да, Enter - нет" { send "\r"; exp_continue }
      "press enter to continue" { send "\r"; exp_continue }
      eof
    }
    catch wait result
    exit [lindex $result 3]
  ' )
}

# Docker ставится официальным скриптом (get.docker.com), не через
# пакетный менеджер дистрибутива — разброс версий/названий пакетов между
# Debian/Ubuntu/CentOS/openSUSE и т.д. слишком велик, чтобы угадывать
# командой из apt/opkg/apk, как для остальных зависимостей. z0r уже
# работает от root (проверено выше), поэтому sudo в команде не нужен.
ensure_docker() {
  command -v docker >/dev/null 2>&1 && return 0
  echo "docker не найден." >&2
  read -re -p "Поставить Docker (curl -fsSL https://get.docker.com | sh)? [y/N]: " ans
  case "$ans" in y|Y) ;; *) return 1 ;; esac

  if ! ensure_curl; then
    echo "curl не найден и не удалось поставить — установи Docker вручную." >&2
    return 1
  fi
  curl -fsSL https://get.docker.com | sh
  command -v docker >/dev/null 2>&1
}

install_z2r() {
  if z2r_installed; then
    read -re -p "z2r уже установлен (/opt/zapret2 есть). Переустановить/обновить поверх? [y/N]: " ans
    case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac
  fi

  if ! ensure_curl; then
    echo "curl не найден и не удалось поставить — установи z2r вручную." >&2
    return 1
  fi

  echo "Сейчас будет скачан и ЗАПУЩЕН установочный скрипт z2r от его автора"
  echo "(не наш код, выполняется с root). Убедись, что доверяешь источнику."
  read -re -p "Продолжить установку z2r? [y/N]: " ans
  case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

  if dns_looks_hijacked raw.githubusercontent.com; then
    offer_doh_setup
  fi

  echo "Пробую основное зеркало (GitHub)..."
  if ( cd /tmp && curl -fO "$Z2R_INSTALL_URL_PRIMARY" ) && run_z2r_installer_unattended /tmp/z2r; then
    echo "z2r установлен (основное зеркало)."
    return 0
  fi

  echo "Основное зеркало недоступно, пробую резервное (git.px.rkn.quest)..."
  if curl -fo /opt/z2r "$Z2R_INSTALL_URL_FALLBACK" && run_z2r_installer_unattended /opt/z2r; then
    echo "z2r установлен (резервное зеркало)."
    return 0
  fi

  echo "Не удалось установить z2r ни с одного зеркала (GitHub у некоторых провайдеров" >&2
  echo "режется/деградирует целиком, живой случай -- см. CLAUDE.md/README)." >&2
  echo "У автора есть офлайн-архив на этот случай (Google Drive, ссылку он периодически" >&2
  echo "обновляет и публикует сам -- не зашита сюда заранее, вставь текущую)." >&2
  read -re -p "Есть ссылка/ID офлайн-архива под рукой? [y/N]: " ans
  case "$ans" in
    y|Y) install_z2r_offline ;;
    *) return 1 ;;
  esac
}

# Последняя ссылка, о которой мы знаем (подтверждена рабочей 2026-08-13,
# см. CLAUDE.md) -- просто удобный дефолт по Enter, НЕ гарантия
# актуальности: автор прямо предупреждает, что она периодически меняется
# и не синхронна с git-версией. install_z2r_offline() сама предложит
# ввести свежую, если эта не сработает -- держать её в актуальном
# состоянии тут не пытаемся.
Z2R_OFFLINE_ARCHIVE_LAST_KNOWN="10c5DZ1wMIjBIRGUzs-FcK2vP7l5g83xy"

# Офлайн-путь для случаев, когда GitHub (raw.githubusercontent.com/
# api.github.com) у провайдера деградирует целиком -- живой случай 2026-08-13,
# оба зеркала install_z2r() недоступны, но сам гугл-драйв не блокируется.
# Архив -- RAR5 под паролем "zator" (публично документированный автором
# константа, не секрет), внутри zator-offline-<версия>.tar.gz, а внутри
# него -- обычный набор файлов + z2r-скрипт для локального запуска.
_z2r_offline_extract_id() {
  local fileid; fileid="$(printf '%s' "$1" | sed -n 's#.*/d/\([A-Za-z0-9_-]\+\).*#\1#p')"
  [ -z "$fileid" ] && fileid="$1"
  printf '%s' "$fileid"
}

install_z2r_offline() {
  read -re -p "Ссылка на Google Drive (вида .../file/d/<ID>/view) или голый ID [Enter -- последняя известная]: " src
  local fileid
  if [ -z "$src" ]; then
    fileid="$Z2R_OFFLINE_ARCHIVE_LAST_KNOWN"
    echo "Использую последнюю известную ссылку -- она может быть устаревшей (автор" >&2
    echo "меняет её время от времени), если не скачается -- спрошу свежую." >&2
  else
    fileid="$(_z2r_offline_extract_id "$src")"
  fi
  if [ -z "$fileid" ]; then
    echo "Пустой ID -- отмена." >&2
    return 1
  fi

  if ! python3 -m pip --version >/dev/null 2>&1; then
    echo "pip не найден, пробую поставить..." >&2
    apt-get install -y python3-pip >/dev/null 2>&1 || opkg install python3-pip >/dev/null 2>&1
  fi
  if ! python3 -c "import gdown" >/dev/null 2>&1; then
    echo "Ставлю gdown (единственный надёжный способ пройти предупреждение" >&2
    echo "Google Drive о вирус-скане для больших файлов)..." >&2
    python3 -m pip install --break-system-packages -q gdown 2>/dev/null \
      || python3 -m pip install -q gdown
  fi

  local workdir; workdir="$(mktemp -d /tmp/z2r_offline.XXXXXX)"
  echo "Качаю архив..."
  if ! python3 -m gdown "https://drive.google.com/uc?id=${fileid}" -O "$workdir/archive"; then
    echo "Не удалось скачать по этому ID/ссылке." >&2
    read -re -p "Есть другая/свежая ссылка? (Enter -- отмена): " src2
    if [ -z "$src2" ]; then
      return 1
    fi
    fileid="$(_z2r_offline_extract_id "$src2")"
    if ! python3 -m gdown "https://drive.google.com/uc?id=${fileid}" -O "$workdir/archive"; then
      echo "И эта не сработала -- отмена." >&2
      return 1
    fi
  fi

  local kind; kind="$(file -b "$workdir/archive")"
  echo "Тип файла: $kind"
  case "$kind" in
    *RAR*)
      command -v unar >/dev/null 2>&1 || apt-get install -y unar >/dev/null 2>&1
      if command -v unar >/dev/null 2>&1; then
        unar -q -p zator -o "$workdir" "$workdir/archive"
      elif command -v unrar >/dev/null 2>&1; then
        ( cd "$workdir" && unrar x -p'zator' archive )
      else
        echo "Нет unar/unrar и не удалось поставить -- распакуй руками:" >&2
        echo "  файл: $workdir/archive, пароль: zator" >&2
        return 1
      fi
      ;;
    *Zip*)
      command -v unzip >/dev/null 2>&1 || apt-get install -y unzip >/dev/null 2>&1
      unzip -q -P zator "$workdir/archive" -d "$workdir"
      ;;
    *)
      echo "Не архив (RAR/ZIP) -- похоже на страницу-предупреждение Google Drive," >&2
      echo "не HTML-эт содержимое. Файл: $workdir/archive" >&2
      return 1
      ;;
  esac

  local inner_tgz; inner_tgz="$(find "$workdir" -maxdepth 2 -iname 'zator-offline-*.tar.gz' | head -1)"
  if [ -z "$inner_tgz" ]; then
    echo "Не нашёл zator-offline-*.tar.gz внутри распакованного архива ($workdir)." >&2
    return 1
  fi
  tar -xzf "$inner_tgz" -C "$workdir"
  local inner_dir; inner_dir="$(dirname "$inner_tgz")"
  local z2r_dir; z2r_dir="$(find "$workdir" -maxdepth 2 -iname 'zator-offline-*' -type d | head -1)"
  if [ -z "$z2r_dir" ] || [ ! -f "$z2r_dir/z2r" ]; then
    echo "Не нашёл распакованный zator-offline-*/z2r." >&2
    return 1
  fi

  echo "Запускаю установщик из офлайн-архива ($z2r_dir)..."
  run_z2r_installer_unattended "$z2r_dir/z2r"
  local rc=$?
  echo "Оставил распакованное в $workdir (можно удалить после проверки: rm -rf $workdir)."
  return $rc
}

# Запускает собственное меню z2r (не наш z0r). По умолчанию тем же способом,
# каким это обычно делают вручную — свежий curl+sh с GitHub (заодно
# подтягивает обновления компонентов z2r перед показом меню, сам z2r.sh
# на это рассчитан и безобиден для уже актуальных файлов — "Без изменений").
# Если GitHub недоступен — тот же резервный источник и та же команда,
# что и в install_z2r() (curl -o /opt/z2r ... && sh /opt/z2r).
launch_z2r() {
  if ensure_curl; then
    if ( cd /tmp && curl -fO "$Z2R_INSTALL_URL_PRIMARY" && sh z2r ); then
      return 0
    fi
    echo "GitHub недоступен, пробую резервный источник (git.px.rkn.quest)..." >&2
    if curl -fo /opt/z2r "$Z2R_INSTALL_URL_FALLBACK" && sh /opt/z2r; then
      return 0
    fi
    echo "Не удалось получить z2r ни с одного источника." >&2
  fi

  local z2r_sh="/opt/z2r.sh"
  if [ -f "$z2r_sh" ]; then
    echo "Запускаю уже установленную локальную копию: $z2r_sh" >&2
    bash "$z2r_sh"
    return $?
  fi

  echo "$z2r_sh не найден и оба источника недоступны — z2r запустить не удалось." >&2
  return 1
}

# Пункт 12: если z2r не установлен — предлагает поставить (install_z2r,
# со своими подтверждениями); если установлен — показывает статус и
# предлагает перезапустить (не переустановить — это разные вещи).
manage_zapret() {
  local st; st="$(get_zapret_status)"
  echo "zapret2: $st"
  if [ "$st" = "NONE" ]; then
    install_z2r
    return
  fi
  read -re -p "Перезапустить zapret2 сейчас? [y/N]: " ans
  case "$ans" in
    y|Y)
      systemctl restart zapret2 2>/dev/null || /opt/zapret2/init.d/sysv/zapret2 restart
      sleep 2
      echo "zapret2 после перезапуска: $(get_zapret_status)"
      ;;
    *) echo "Ок, не трогаю." ;;
  esac
}

# Пункт 13: если демон не установлен — предлагает поставить+включить; если
# установлен, но остановлен — предлагает включить; если работает —
# предлагает остановить (без удаления юнита, см. uninstall_daemon для этого).
manage_daemon() {
  local st; st="$(get_daemon_status)"
  echo "autotune-daemon: $st"
  case "$st" in
    NONE)
      read -re -p "Сервис не установлен. Поставить и включить сейчас? [y/N]: " ans
      case "$ans" in y|Y) install_daemon_service 0 ;; *) echo "Отмена." ;; esac
      ;;
    OFF)
      read -re -p "Сервис установлен, но не запущен. Включить сейчас? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl enable --now autotune-daemon; sleep 1; systemctl status autotune-daemon --no-pager ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
    ON)
      read -re -p "Сервис работает. Остановить и отключить? [y/N]: " ans
      case "$ans" in
        y|Y)
          systemctl disable --now autotune-daemon 2>/dev/null || true
          echo "autotune-daemon остановлен и отключён (юнит остался — включить снова: пункт 22 -> 5)."
          ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
  esac
}

# Пункт 14: Discord-бот для тестирования VOICE_UDP (профиль 6).
# z2r_test-voice-bot — отдельный репозиторий, без своего systemd-юнита
# (запускается как "venv/bin/python3 bot.py" через run.sh) — юнит для него
# держим у себя (z2r-test-voice-bot.service).
manage_voice_bot() {
  local st; st="$(get_voice_bot_status)"
  echo "Discord_bot: $st"
  case "$st" in
    NONE)
      read -re -p "Склонировать и подготовить z2r_test-voice-bot в $VOICE_BOT_DIR? [y/N]: " ans
      case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

      if ! command -v git >/dev/null 2>&1; then
        echo "git не найден, пробую поставить..." >&2
        apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
        apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
      fi
      if ! git clone "$VOICE_BOT_REPO_URL" "$VOICE_BOT_DIR"; then
        echo "Не удалось склонировать $VOICE_BOT_REPO_URL — GitHub недоступен?" >&2
        return 1
      fi

      if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 не найден, пробую поставить..." >&2
        apt-get install -y python3 python3-venv >/dev/null 2>&1 || opkg install python3 >/dev/null 2>&1 || apk add python3 >/dev/null 2>&1
      fi
      if ! ( cd "$VOICE_BOT_DIR" && python3 -m venv venv \
             && venv/bin/pip install -q -r requirements.txt \
             && venv/bin/pip install -q "discord.py[voice]" ); then
        echo "Не удалось поставить зависимости бота — доразберись руками в $VOICE_BOT_DIR." >&2
        return 1
      fi
      [ -f "$VOICE_BOT_DIR/.env" ] || cp "$VOICE_BOT_DIR/.env.example" "$VOICE_BOT_DIR/.env"

      echo ""
      echo "Склонирован и готов к настройке. Перед включением (пункт 14 ещё раз):"
      echo "  1. Заполни реальными значениями: $VOICE_BOT_DIR/.env"
      echo "     (DISCORD_TOKEN, GUILD_ID, TEST_VOICE_CHANNEL_ID, OWNER_USER_ID)"
      echo "     Список стратегий бот строит сам динамически (set_strategy_cli.sh"
      echo "     max) — отдельного файла со списком заводить не нужно."
      echo "  2. Нужен уже поставленный Zenith (пункт 22) — бот тестирует через"
      echo "     его песочницу, юзера zenith-voice-bot без него не будет."
      ;;
    OFF)
      if ! id zenith-voice-bot >/dev/null 2>&1; then
        echo "Юзера zenith-voice-bot нет — сначала поставь/настрой Zenith (пункт 22," >&2
        echo "manage_zenith -> setup_sandbox.sh создаёт этого юзера)." >&2
        return 1
      fi
      if [ ! -f "/etc/systemd/system/${VOICE_BOT_SERVICE}.service" ]; then
        if [ ! -f "$SCRIPT_DIR/${VOICE_BOT_SERVICE}.service" ]; then
          echo "Не найден $SCRIPT_DIR/${VOICE_BOT_SERVICE}.service — что-то не так с чекаутом репозитория." >&2
          return 1
        fi
        cp -f "$SCRIPT_DIR/${VOICE_BOT_SERVICE}.service" "/etc/systemd/system/${VOICE_BOT_SERVICE}.service"
        systemctl daemon-reload
      fi
      # Узкий sudoers на рестарт песочницы + перезапись её конфига --
      # юнит бота работает от zenith-voice-bot (см. .service), оба
      # скрипта требуют root (конфиг обычно root-owned, пересоздаётся
      # Zenith'овским main.py через sudo для TCP-профилей).
      local sudoers_file="/etc/sudoers.d/zenith-voice-bot"
      local sudoers_line1="zenith-voice-bot ALL=(root) NOPASSWD: $ZENITH_DIR/sandbox/start_sandbox.sh"
      local sudoers_line2="zenith-voice-bot ALL=(root) NOPASSWD: $ZENITH_DIR/sandbox/write_conf.sh"
      if [ ! -f "$sudoers_file" ] || ! grep -qxF "$sudoers_line1" "$sudoers_file" 2>/dev/null \
         || ! grep -qxF "$sudoers_line2" "$sudoers_file" 2>/dev/null; then
        { echo "$sudoers_line1"; echo "$sudoers_line2"; } > "$sudoers_file"
        chmod 440 "$sudoers_file"
        echo "Добавлен/обновлён $sudoers_file."
      fi
      read -re -p "Сервис установлен, но не запущен. Включить сейчас? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl enable --now "$VOICE_BOT_SERVICE"; sleep 2; systemctl status "$VOICE_BOT_SERVICE" --no-pager ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
    ON)
      read -re -p "Сервис работает. Остановить и отключить? [y/N]: " ans
      case "$ans" in
        y|Y) systemctl disable --now "$VOICE_BOT_SERVICE" 2>/dev/null || true; echo "Остановлен." ;;
        *) echo "Ок, не трогаю." ;;
      esac
      ;;
  esac
}

# Одна строка-конфиг вместо блока -- base64(JSON), как VLESS/Outline/
# WireGuard-ключи: адрес+порт+токен зашиты внутрь одной непрозрачной
# строки, копипастится единственным куском, меньше риска частичной
# вставки/битых пробелов, чем даже у блока KEY=value ниже (по прямому
# запросу, спасибо за наводку). Формат {"m":"panel", ...поля...}, см.
# z0r-panel/main.py::make_connect_string -- единственная сторона, что
# печатает строку (раньше был ещё режим "db" от
# Zenith/db/create_remote_db_user.sh -- убран вместе со скриптом, сырой
# MySQL наружу больше не выдаётся никому, оба режима синка и api ходят
# через панель одним и тем же "panel"-форматом). "0" на stdout -- не
# удалось распознать (не наш base64/JSON) -- вызывающий код откатывается
# на apply_env_paste_block, затем на read -p по одному полю.
decode_connect_string() {
  local envfile="$1" str="$2"
  local out
  out="$(python3 - "$str" <<'PYEOF' 2>/dev/null
import base64, json, sys

s = sys.argv[1].strip()
try:
    data = base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))
    obj = json.loads(data)
except Exception:
    sys.exit(1)

FIELD_MAP = {
    "panel": {
        "url": "PANEL_URL", "token": "PANEL_NODE_TOKEN",
        "name": "ZENITH_ENVIRONMENT_NAME", "provider": "ZENITH_ENVIRONMENT_PROVIDER",
    },
}
fields = FIELD_MAP.get(obj.get("m"))
if not fields:
    sys.exit(1)
for jkey, envkey in fields.items():
    if obj.get(jkey) not in (None, ""):
        print(f"{envkey}={obj[jkey]}")
PYEOF
)"
  if [ -z "$out" ]; then
    echo "0"
    return
  fi
  local applied=0 line key val
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    key="${line%%=*}"; val="${line#*=}"
    sed -i "s@^#\?[[:space:]]*${key}=.*@${key}=${val}@" "$envfile"
    applied=$((applied + 1))
    echo "  принято (из строки-конфига): $key" >&2
  done <<< "$out"
  echo "$applied"
}

# Читает вставленный целиком блок KEY=value (по строке на переменную,
# пустая строка или Ctrl+D завершает) и применяет распознанные ключи в
# указанный .env -- create_remote_db_user.sh и панель (/nodes -> "Создать
# токен") печатают именно такой блок для копипаста одним куском, вместо
# набора значений по одному полю (по мотивам того, как Remnawave выдаёт
# готовый docker-compose.yml с уже подставленными значениями, а не просит
# вписывать host/port/token в интерактивные вопросы по одному -- меньше
# ручного транскрибирования, меньше опечаток вроде вставленных как есть
# угловых скобок-плейсхолдеров). Печатает число применённых строк на
# stdout (остальной вывод -- в stderr) -- 0 значит ничего не вставили,
# вызывающий код должен откатиться на прежние индивидуальные read -p.
apply_env_paste_block() {
  local envfile="$1"; shift
  local allowed=" $* "
  local line key val applied=0
  echo "Вставь блок вида KEY=value (по строке на переменную) -- из вывода" >&2
  echo "create_remote_db_user.sh или кнопки \"Создать токен\" в панели." >&2
  echo "Пустая строка или Ctrl+D — закончить, ничего не вставлять — ввести поля по одному:" >&2
  while IFS= read -r line; do
    line="${line%$'\r'}"
    [ -z "$line" ] && break
    key="${line%%=*}"
    val="${line#*=}"
    # trim -- create_remote_db_user.sh/панель печатают флеш-лефт, но
    # мало ли откуда реально скопируют (отступы, случайные пробелы)
    key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
    case "$allowed" in
      *" $key "*)
        sed -i "s@^#\?[[:space:]]*${key}=.*@${key}=${val}@" "$envfile"
        applied=$((applied + 1))
        echo "  принято: $key" >&2
        ;;
      *) [ -n "$key" ] && echo "  пропущено (незнакомый ключ): $key" >&2 ;;
    esac
  done
  echo "$applied"
}

# Спрашивает докер-контейнер или уже-нативную БД при ZENITH_DB_MODE=docker
# -- пишет ZENITH_DB_BACKEND в .env, читается zenith_db_backend() выше.
# native подразумевает, что схема+миграции (db/schema.sql, db/migrations/)
# уже применены заранее вручную -- z0r их сам не накатывает.
ask_zenith_db_backend() {
  local envfile="$1" ans
  echo ""
  read -re -p "Локальная БД: поднять в Docker, или уже стоит нативно в системе (mariadb-server/mysql-server)? [D/n]: " ans
  case "$ans" in
    n|N)
      if grep -q '^ZENITH_DB_BACKEND=' "$envfile" 2>/dev/null; then
        sed -i 's/^ZENITH_DB_BACKEND=.*/ZENITH_DB_BACKEND=native/' "$envfile"
      else
        echo "ZENITH_DB_BACKEND=native" >> "$envfile"
      fi
      echo "Нативная БД: z0r не трогает Docker, статус/старт-стоп идут через systemctl (mariadb.service)."
      echo "Проверь, что схема применена: cat $ZENITH_DIR/db/schema.sql | mariadb -u<user> -p <db>"
      ;;
    *)
      if grep -q '^ZENITH_DB_BACKEND=' "$envfile" 2>/dev/null; then
        sed -i 's/^ZENITH_DB_BACKEND=.*/ZENITH_DB_BACKEND=docker/' "$envfile"
      else
        echo "ZENITH_DB_BACKEND=docker" >> "$envfile"
      fi
      ;;
  esac
}

# Пункт 22 — если Zenith ещё не склонирован, сначала предлагает это
# сделать и спрашивает про БД (своя в Docker или уже существующая), а
# дальше — независимо от того, только что склонировали или он уже стоял —
# открывает его собственное подменю (zenith_menu).
manage_zenith() {
  local st; st="$(get_zenith_status)"
  echo "Zenith: $st"

  if [ "$st" = "NONE" ]; then
    read -re -p "Склонировать Zenith в $ZENITH_DIR? [y/N]: " ans
    case "$ans" in y|Y) ;; *) echo "Отмена."; return 0 ;; esac

    if ! command -v git >/dev/null 2>&1; then
      echo "git не найден, пробую поставить..." >&2
      apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
      apt-get install -y git >/dev/null 2>&1 || opkg install git >/dev/null 2>&1 || apk add git >/dev/null 2>&1
    fi
    if ! git clone "$ZENITH_REPO_URL" "$ZENITH_DIR"; then
      echo "Не удалось склонировать $ZENITH_REPO_URL — GitHub недоступен?" >&2
      return 1
    fi
    cp "$ZENITH_DIR/.env.example" "$ZENITH_DIR/.env"

    # Имя/провайдер ноды -- автоматически, не руками (по прямому запросу:
    # готовимся к деплою на МТС, там должно пройти без ручной доводки).
    # Имя -- hostname этой машины (уникальность внутри флота обеспечивает
    # panel self_report_node -- при конфликте вернёт понятную 409, поправить
    # руками останется только в этом редком случае). Провайдер -- тот же
    # детектор ISP, что уже используется в шапке меню (get_provider),
    # слагифицирован в машинный вид. Применяется ко ВСЕМ веткам ниже,
    # включая полностью локальную (иначе там осталось бы "prod-domru" из
    # .env.example нетронутым).
    local auto_name auto_provider
    auto_name="$(hostname)"
    auto_provider="$(slugify_provider "$(get_provider)")"
    sed -i "s/^ZENITH_ENVIRONMENT_NAME=.*/ZENITH_ENVIRONMENT_NAME=$auto_name/" "$ZENITH_DIR/.env"
    sed -i "s/^ZENITH_ENVIRONMENT_PROVIDER=.*/ZENITH_ENVIRONMENT_PROVIDER=$auto_provider/" "$ZENITH_DIR/.env"
    echo "Имя ноды: $auto_name, провайдер: $auto_provider (определено автоматически)."

    # Два вопроса вместо трёх пунктов меню -- см. README Zenith "Два
    # режима БД". Раньше был выбор 1/2/3 сразу (локальная/hub-and-
    # spoke/центральная-напрямую) -- центральная-напрямую (сырой MySQL
    # наружу) убрана целиком, режим "без своей БД" (api) теперь ходит
    # через панель по HTTP+токену, тем же способом, что и синк.
    echo ""
    read -re -p "Синхронизироваться с центральной панелью? [Y/n]: " syncans
    case "$syncans" in
      n|N) sync_with_panel=0 ;;
      *) sync_with_panel=1 ;;
    esac

    if [ "$sync_with_panel" = "0" ]; then
      sed -i 's/^ZENITH_DB_MODE=.*/ZENITH_DB_MODE=docker/' "$ZENITH_DIR/.env"
      ask_zenith_db_backend "$ZENITH_DIR/.env"
      echo "При желании поменяй пароли: $ZENITH_DIR/.env"
      echo "Изолированная нода -- своя локальная БД, без панели."
    else
      echo ""
      read -re -p "Строка-конфиг с /nodes панели (одна строка, если она есть; иначе Enter): " connstr
      applied=0
      [ -n "$connstr" ] && applied="$(decode_connect_string "$ZENITH_DIR/.env" "$connstr")"
      [ "$applied" = "0" ] && applied="$(apply_env_paste_block "$ZENITH_DIR/.env" PANEL_URL PANEL_NODE_TOKEN)"
      if [ "$applied" = "0" ]; then
        read -re -p "  PANEL_URL (напр. https://panel.example.com:2087): " purl
        read -rse -p "  Токен ноды (создать заранее в панели: /nodes -> \"Создать токен\"): " ptoken; echo ""
        [ -n "$purl" ] && sed -i "s@^#\?[[:space:]]*PANEL_URL=.*@PANEL_URL=$purl@" "$ZENITH_DIR/.env"
        [ -n "$ptoken" ] && sed -i "s@^#\?[[:space:]]*PANEL_NODE_TOKEN=.*@PANEL_NODE_TOKEN=$ptoken@" "$ZENITH_DIR/.env"
      fi

      echo ""
      read -re -p "Держать локальную БД как буфер (переживает недоступность панели)? [Y/n]: " bufans
      case "$bufans" in
        n|N)
          sed -i 's/^ZENITH_DB_MODE=.*/ZENITH_DB_MODE=api/' "$ZENITH_DIR/.env"
          echo "Настроено: без своей БД, всё через панель по HTTP -- Docker/MySQL тут не нужны вообще."
          ;;
        *)
          sed -i 's/^ZENITH_DB_MODE=.*/ZENITH_DB_MODE=docker/' "$ZENITH_DIR/.env"
          ask_zenith_db_backend "$ZENITH_DIR/.env"
          echo "При желании поменяй пароли: $ZENITH_DIR/.env"
          echo "Настроено: локальная БД как буфер + синк с панелью."
          ;;
      esac
      echo "Подключено."
    fi

    echo ""
    echo "Готовлю Python-окружение оркестратора..."
    if ensure_python_venv; then
      if ( cd "$ZENITH_DIR/orchestrator" && python3 -m venv venv && venv/bin/pip install -q -r requirements.txt ); then
        echo "venv готов: $ZENITH_DIR/orchestrator/venv"
        echo "После установки песочницы (см. README Zenith \"VOICE_UDP\"/\"Как тестируются"
        echo "новые геномы\") можно сразу:"
        echo "  cd $ZENITH_DIR/orchestrator && sudo venv/bin/python3 bootstrap.py --profile <PROFILE>"
      else
        echo "venv создался, но pip install упал -- проверь requirements.txt/сеть вручную." >&2
      fi
    else
      echo "Не удалось поставить рабочий python3-venv -- подготовь venv руками:" >&2
      echo "  cd $ZENITH_DIR/orchestrator && python3 -m venv venv && venv/bin/pip install -r requirements.txt" >&2
    fi
  fi

  zenith_menu
}

# Собственное подменю Zenith. Сейчас в репозитории только каркас (БД, без
# самой логики генератора — см. его README) — пункты 2/3 читают то, что
# УЖЕ накопилось в genome_scores/experiments, и пока честно покажут пусто,
# пока генератор не перенесён и не начал их наполнять.
zenith_menu() {
  while true; do
    local st mode backend_suffix; st="$(get_zenith_status)"; mode="$(zenith_db_mode)"
    backend_suffix=""
    [ "$mode" = "docker" ] && [ "$(zenith_db_backend)" = "native" ] && backend_suffix="/native"
    echo ""
    echo "=== Zenith $(color_tag "$st") (БД: $mode$backend_suffix) ==="
    echo "  1) Запуск/Стоп"
    echo "  2) Стратегии для текущего провайдера"
    echo "  3) Стратегии по профилям"
    echo "  4) Автономный режим (генерация + автопродвижение БЕЗ человека)"
    echo "  5) autotune-daemon $(color_tag "$(get_daemon_status)") -- НЕ часть Zenith, отдельный"
    echo "     независимый механизм z2r_autobench (rank_strategies.sh-подбор внутри"
    echo "     профиля, без БД/геномов) -- собран тут просто для удобства, одно место"
    echo "     для всего авто-тюнинга. Пункты 4 и 5 пишут в один и тот же боевой"
    echo "     конфиг и рестартуют zapret2 НЕЗАВИСИМО друг от друга -- держать оба"
    echo "     включёнными разом не проверялось, см. CLAUDE.md."
    echo "  0) Назад в главное меню"
    echo ""
    read -re -p "Zenith > " zchoice
    case "$zchoice" in
      1) zenith_toggle ;;
      2) zenith_show_provider_strategies ;;
      3) zenith_profiles_submenu ;;
      4) zenith_autonomy_menu ;;
      5) manage_daemon ;;
      0|q|Q|"") return 0 ;;
      *) echo "Неизвестный выбор." ;;
    esac
  done
}

# Автообновление -- по одному флагу на проект в $AUTOUPDATE_CONF, общий
# файл с z0r-panel (там своя веб-страница настроек читает/пишет то же
# самое -- см. README z0r-panel), не своя отдельная копия состояния.
# "Обновление" = git pull --ff-only от main (не от текущей рабочей
# ветки -- продакшен подтягивает то, что реально смержено) +
# специфичный для проекта рестарт, вся логика -- в autoupdate.sh.
#
# Меню сокращено до одного общего переключателя -- сам определяет, какие
# модули реально установлены (по наличию каталога), и включает/выключает
# их все разом. Zenith намеренно исключён из общего переключателя -- его
# "обновление" это полная пересборка docker-контейнера, а не лёгкий git
# pull + рестарт, как у остальных, поэтому оставлен отдельным пунктом.
autoupdate_included_projects() {
  local projects=(z2r_autobench)
  [ -d "$PANEL_DIR" ] && projects+=(panel)
  [ -d "$TGRELAY_DIR" ] && projects+=(tgrelay)
  printf '%s\n' "${projects[@]}"
}

autoupdate_project_label() {
  case "$1" in
    z2r_autobench) echo "z2r_autobench (сам инструмент + autotune-daemon)" ;;
    panel) echo "z0r-panel (pip install + systemctl restart zenith-panel)" ;;
    tgrelay) echo "Zenith-TG (pip install + systemctl restart tg-transparent-relay)" ;;
    zenith)
      if [ "$(zenith_db_backend)" = "native" ]; then
        echo "Zenith (git pull, БД нативная -- Docker не трогаю)"
      else
        echo "Zenith (docker compose up -d --build)"
      fi
      ;;
  esac
}

autoupdate_master_status() {
  local p
  while IFS= read -r p; do
    [ "$(autoupdate_conf_get "$p")" = "1" ] || { echo "0"; return; }
  done < <(autoupdate_included_projects)
  echo "1"
}

autoupdate_set_master() {
  local value="$1" p
  while IFS= read -r p; do
    autoupdate_conf_set "$p" "$value"
  done < <(autoupdate_included_projects)
}

autoupdate_offer_timer() {
  [ "$(get_autoupdate_timer_status)" = "ON" ] && return 0
  read -re -p "Таймер автообновления ещё не запущен -- установить и включить сейчас? [Y/n]: " ans
  case "$ans" in n|N) ;; *) install_autoupdate_timer ;; esac
}

autoupdate_menu() {
  while true; do
    echo ""
    echo "=== Автообновление (таймер: $(color_tag "$(get_autoupdate_timer_status)"), проверка ~раз в 20 мин) ==="
    echo ""
    local master; master="$(autoupdate_master_status)"
    printf "  1) [%s] Автообновление установленных модулей\n" "$([ "$master" = "1" ] && echo "ВКЛ" || echo "выкл")"
    local p
    while IFS= read -r p; do
      printf "     - %s -- последнее обновление: %s\n" "$(autoupdate_project_label "$p")" "$(autoupdate_last_update "$p")"
    done < <(autoupdate_included_projects)
    if [ -d "$ZENITH_DIR" ]; then
      local zenith_enabled; zenith_enabled="$(autoupdate_conf_get zenith)"
      printf "  2) [%s] %s\n" "$([ "$zenith_enabled" = "1" ] && echo "ВКЛ" || echo "выкл")" "$(autoupdate_project_label zenith)"
      printf "     последнее обновление: %s\n" "$(autoupdate_last_update zenith)"
    fi
    echo ""
    echo "  r) Прогнать обновление прямо сейчас (для всех включённых)"
    echo "  0) Назад"
    echo ""
    read -re -p "Автообновление > " achoice
    case "$achoice" in
      1)
        local new; new=$([ "$master" = "1" ] && echo "0" || echo "1")
        autoupdate_set_master "$new"
        echo "Автообновление установленных модулей: $([ "$new" = "1" ] && echo "включено" || echo "выключено")."
        [ "$new" = "1" ] && autoupdate_offer_timer
        ;;
      2)
        if [ -d "$ZENITH_DIR" ]; then
          local current new
          current="$(autoupdate_conf_get zenith)"
          new=$([ "$current" = "1" ] && echo "0" || echo "1")
          autoupdate_conf_set zenith "$new"
          echo "Zenith: $([ "$new" = "1" ] && echo "включено" || echo "выключено")."
          [ "$new" = "1" ] && autoupdate_offer_timer
        else
          echo "Неизвестный выбор."
        fi
        ;;
      r|R)
        echo "Запускаю $INSTALL_DIR/autoupdate.sh вручную..."
        bash "$INSTALL_DIR/autoupdate.sh"
        echo "Готово, подробности: $INSTALL_DIR/logs/autoupdate/"
        ;;
      0|q|Q|"") return 0 ;;
      *) echo "Неизвестный выбор." ;;
    esac
  done
}

# Копирует .service из $ZENITH_DIR (репозиторий Zenith сам их содержит,
# та же схема, что zenith-panel.service в z0r-panel) в systemd и
# перечитывает юниты, только если файл новый/изменился -- идемпотентно,
# как ensure_panel_runtime_grants.
install_zenith_service() {
  local unit_name="$1"
  local unit_src="$ZENITH_DIR/${unit_name}.service"
  local unit_dst="/etc/systemd/system/${unit_name}.service"
  if [ ! -f "$unit_src" ]; then
    echo "$unit_src не найден -- обнови Zenith (git pull в $ZENITH_DIR)." >&2
    return 1
  fi
  if [ ! -f "$unit_dst" ] || ! cmp -s "$unit_src" "$unit_dst"; then
    cp -f "$unit_src" "$unit_dst"
    systemctl daemon-reload
    echo "Установлен/обновлён $unit_dst."
  fi
  return 0
}

# zenith-autorun.service (периодическая генерация кандидатов) +
# zenith-promoter.service (автопродвижение в /opt/zapret2/config БЕЗ
# человека, см. Zenith/README.md "Автономный режим") -- оба
# НЕЗАВИСИМЫ от z0r-panel, читай п.4 докстрин выше. Панель, если
# установлена, просто дублирует start/stop/log поверх ЭТИХ ЖЕ юнитов.
zenith_autonomy_menu() {
  while true; do
    local ar_st pr_st
    ar_st="$(get_zenith_autorun_status)"
    pr_st="$(get_zenith_promoter_status)"
    echo ""
    echo "=== Автономный режим Zenith ==="
    echo "  1) zenith-autorun (генерация кандидатов) $(color_tag "$ar_st")"
    echo "  2) zenith-promoter (автопродвижение в прод) $(color_tag "$pr_st")"
    echo "  3) Лог zenith-autorun (journalctl -f, Ctrl+C для выхода)"
    echo "  4) Лог zenith-promoter (journalctl -f, Ctrl+C для выхода)"
    echo "  0) Назад"
    echo ""
    read -re -p "Автономный режим > " achoice
    case "$achoice" in
      1)
        install_zenith_service zenith-autorun || continue
        if [ "$ar_st" = "ON" ]; then
          systemctl disable --now zenith-autorun
          echo "zenith-autorun остановлен и отключён."
        else
          systemctl enable --now zenith-autorun
          sleep 1
          systemctl status zenith-autorun --no-pager
        fi
        ;;
      2)
        install_zenith_service zenith-promoter || continue
        if [ "$pr_st" = "ON" ]; then
          systemctl disable --now zenith-promoter
          echo "zenith-promoter остановлен и отключён."
        else
          echo "!!! zenith-promoter пишет /opt/zapret2/config и рестартует zapret2"
          echo "БЕЗ подтверждения человека на каждом срабатывании. Перед первым"
          echo "включением на этом сервере рекомендуется проверить руками:"
          echo "  cd $ZENITH_DIR/orchestrator && sudo venv/bin/python3 auto_promoter.py --profile <PROFILE>"
          read -re -p "Включить zenith-promoter сейчас? [y/N]: " ans
          case "$ans" in
            y|Y)
              systemctl enable --now zenith-promoter
              sleep 1
              systemctl status zenith-promoter --no-pager
              ;;
            *) echo "Отмена." ;;
          esac
        fi
        ;;
      3) journalctl -u zenith-autorun -f ;;
      4) journalctl -u zenith-promoter -f ;;
      0|q|Q|"") return 0 ;;
      *) echo "Неизвестный выбор." ;;
    esac
  done
}

