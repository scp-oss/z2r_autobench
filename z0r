LOCKED_TSV="/opt/zapret2/extra_strats/cache/orchestra/locked.tsv"
LOCKED_MANUAL_TSV="/opt/zapret2/extra_strats/cache/orchestra/locked.manual.tsv"
PROVIDER_CACHE="$INSTALL_DIR/.provider_cache"
# z2r_test-voice-bot — отдельный репозиторий (не часть z2r_autobench),
# клонируем по требованию сюда. У него нет своего systemd-юнита — держим
# свой (z2r-test-voice-bot.service, лежит рядом с autotune-daemon.service).
VOICE_BOT_DIR="$INSTALL_DIR/z2r_test-voice-bot"
VOICE_BOT_REPO_URL="https://github.com/scp-oss/z2r_test-voice-bot.git"
VOICE_BOT_SERVICE="z2r-test-voice-bot"
# Zenith — автоподборщик-генератор стратегий (отдельный репозиторий).
# Docker нужен только для локальной БД (ZENITH_DB_MODE=docker) — в режиме
# api (без своей БД, всё через панель по HTTP) Docker вообще не используется.
ZENITH_DIR="$INSTALL_DIR/Zenith"
ZENITH_REPO_URL="https://github.com/scp-oss/zenith.git"
# z0r-panel — веб-панель для Zenith (обзор по нодам/провайдерам, история
# мутаций, sync-хаб), отдельный репозиторий (была вложенной Zenith/panel/,
# выделена отдельно). Своя .env/venv/systemd-юнит, к MySQL Zenith ходит
# как обычный клиент — при первой установке подхватываем MYSQL_*/
# ZENITH_ENVIRONMENT_* из уже настроенного $ZENITH_DIR/.env, если он есть
# (см. manage_panel), а не просим вводить те же значения второй раз.
PANEL_DIR="$INSTALL_DIR/z0r-panel"
PANEL_REPO_URL="https://github.com/scp-oss/z0r-panel.git"
PANEL_SERVICE="zenith-panel"
# Zenith-TG — прозрачный доступ к Telegram (отдельный репозиторий). Не
# десинк-профиль zapret2 (проверено вживую — не помогает против
# IP-блэклиста конкретных DC-адресов Telegram), а relay без MTProxy-
# секрета: iptables REDIRECT молча заворачивает исходящий TCP:443 к
# подсетям Telegram на локальный relay/transparent_relay.py, который сам
# умеет достучаться до Telegram (вендоренная relay-машинерия
# Flowseal/tg-ws-proxy). Клиенту (Telegram Desktop/mobile) ничего
# настраивать не нужно — см. README репозитория.
TGRELAY_DIR="$INSTALL_DIR/Zenith-TG"
TGRELAY_REPO_URL="https://github.com/scp-oss/Zenith-TG.git"
TGRELAY_SERVICE="tg-transparent-relay"
# DNSCrypt-proxy -- локальный DoH-резолвер, не самописный компонент этого
# репозитория, а обычный пакет дистрибутива. Появился из живого случая
# 2026-08-22 (NETH-4): провайдер начал резать обычный DNS/DoT/DoH к
# популярным резолверам (кроме Яндекса, который сам подчиняется реестру
# и на заблокированных доменах отдаёт то же самое, что и блокировка) --
# youtube.com резолвился в NXDOMAIN даже через 8.8.8.8, но нормально через
# DoH к cloudflare-dns.com/dns.nextdns.io/dns.sb. Ограничиваем server_names
# именно этими тремя подтверждёнными вживую, не полагаемся на дефолтный
# список пакета.
DNSCRYPT_TOML="/etc/dnscrypt-proxy/dnscrypt-proxy.toml"
DNSCRYPT_SERVER_NAMES="server_names = ['cloudflare', 'cloudflare-ipv6', 'nextdns', 'sb']"
DNSCRYPT_DHCPCD_MARKER="# z0r-dnscrypt: локальный DoH-резолвер (dnscrypt-proxy), добавлено z0r"
# Автообновление всей экосистемы (z2r_autobench/Zenith/z0r-panel/
# Zenith-TG) -- общий конфиг с z0r-panel (веб тоже читает/пишет ЭТОТ ЖЕ
# файл, см. autoupdate.sh и README z0r-panel), не свой отдельный.
AUTOUPDATE_CONF="/etc/z2r_autobench/autoupdate.conf"
PASSES="${PASSES:-3}"
MODE=""
SINGLE_PROFILE=""
SELECTED_PROFILES=""
CUSTOM_DOMAIN=""
APPLY_FLAG=""

# Зеркала официального установщика z2r (не наш код — просто то, чем сейчас
# ставят z2r вручную; второе зеркало для тех, у кого GitHub недоступен).
Z2R_INSTALL_URL_PRIMARY="https://raw.githubusercontent.com/AloofLibra/z4r/z2r/z2r"
Z2R_INSTALL_URL_FALLBACK="https://git.px.rkn.quest/z2r/plain/z2r?h=z2r"

# запоминаем исходные аргументы ДО разбора (который их shift'ит) — нужны
# нетронутыми, если ниже придётся перезапускаться из установленной копии
ORIG_ARGS=("$@")

while [ $# -gt 0 ]; do
  case "$1" in
    --profile) SINGLE_PROFILE="$2"; MODE="single"; shift 2 ;;
    --profiles) SELECTED_PROFILES="$2"; MODE="selected"; shift 2 ;;
    --all) MODE="all"; shift ;;
    --domain) CUSTOM_DOMAIN="$2"; MODE="domain"; shift 2 ;;
    --passes) PASSES="$2"; shift 2 ;;
    --apply) APPLY_FLAG="--apply"; shift ;;
    --install-service) MODE="install"; shift ;;
    --install-z2r) MODE="install-z2r"; shift ;;
    --install-z2r-offline) MODE="install-z2r-offline"; shift ;;
    --uninstall) MODE="uninstall"; shift ;;
    *) echo "Неизвестный аргумент: $1" >&2; exit 1 ;;
  esac
done

if [ "$(id -u)" != "0" ]; then
  echo "Нужен root." >&2
  exit 1
fi

declare -A TITLES=(
  [1]="YT_TLS"
  [2]="GV_TLS"
  [3]="RKN_TLS"
  [4]="DS_TLS"
  [5]="YT_QUIC_UDP"
  [6]="VOICE_UDP"
  [7]="GAMES_UDP"
  [8]="FB_TLS"
  [9]="FB_HTTP"
)

# Протоколы каждого профиля — нужно знать, во сколько вызовов
# set_strategy_cli.sh разложить применение лучшей стратегии (см. offer_apply_best).
declare -A PROFILE_PROTO=(
  [1]="tls http"
  [2]="tls"
  [3]="tls"
  [4]="tls"
  [5]="udp"
  [6]="udp"
  [8]="tls"
  [9]="http"
)

# Зависимости между профилями: 2 (GV_TLS) и 5 (YT_QUIC_UDP) резолвят тестовый
# URL через yt-dlp -> youtube.com, а этот запрос идёт через ЖИВУЮ стратегию
# профиля 1 (YT_TLS). Если у профиля 1 в моменте сломанная стратегия, тесты
# 2 и 5 валятся со 100%-провалом не из-за собственных стратегий, а из-за
# резолвинга. Поэтому при прогоне 2 и/или 5 профиль 1 всегда тестируется
# первым, и его лучшая стратегия применяется СРАЗУ, без вопроса — иначе сам
# смысл теста 2/5 теряется. 4 и 6 сознательно не рассматриваем (отдельная
# история, не такая прямая зависимость).
declare -A PROFILE_DEPENDS_ON=(
  [2]="1"
  [5]="1"
)

# Разворачивает список профилей ($1, через пробел), вставляя перед каждым
# зависящим профилем его зависимость (один раз, в порядке появления).
# "2" -> "1 2", "2 5" -> "1 2 5", "1 2 5" -> "1 2 5" (без дублей).
expand_with_deps() {
  local raw="$1" pid dep result=" "
  for pid in $raw; do
    dep="${PROFILE_DEPENDS_ON[$pid]:-}"
    if [ -n "$dep" ]; then
      case "$result" in
        *" $dep "*) ;;
        *) result="$result$dep " ;;
      esac
    fi
    case "$result" in
      *" $pid "*) ;;
      *) result="$result$pid " ;;
    esac
  done
  echo "$result"
}

# Из уже развёрнутого списка ($1) находит профили, которые в нём являются
# чьей-то зависимостью — для них лучшую стратегию нужно применять сразу
# и без вопроса (см. offer_apply_best/apply_best_auto ниже).
compute_auto_ids() {
  local ids="$1" pid dep auto=" "
  for pid in $ids; do
    dep="${PROFILE_DEPENDS_ON[$pid]:-}"
    if [ -n "$dep" ]; then
      case " $ids " in
        *" $dep "*)
          case "$auto" in
            *" $dep "*) ;;
            *) auto="$auto$dep " ;;
          esac
          ;;
      esac
    fi
  done
  echo "$auto"
}

read_last_ordered() {
  # $1 = profile id, печатает содержимое last_ordered_profile_<N>.txt или пусто
  local f="$LOG_DIR/last_ordered_profile_$1.txt"
  [ -f "$f" ] && cat "$f" || echo ""
}

test_profile() {
  local pid="$1"
  local title="${TITLES[$pid]}"

  case "$pid" in
    1|2|3|4|8|9)
      echo "--- Тестирую $title (профиль $pid), $PASSES проход(ов) ---"
      bash "$SCRIPT_DIR/rank_strategies.sh" --profile "$pid" --passes "$PASSES" --funnel
      local ordered
      ordered="$(read_last_ordered "$pid")"
      echo ""
      echo ">>> $pid $title: ${ordered:-нет успешных}"
      ;;
    5)
      echo "--- Тестирую $title (профиль 5, QUIC), $PASSES проход(ов) ---"
      bash "$SCRIPT_DIR/rank_quic.sh" --passes "$PASSES" --funnel
      local ordered
      ordered="$(read_last_ordered "5")"
      echo ""
      echo ">>> $pid $title: ${ordered:-нет успешных}"
      ;;
    6)
      echo "--- $title (профиль 6): читаю уже накопленные данные бота ---"
      if [ -f "$LOG_DIR/voice_bot_raw.tsv" ]; then
        bash "$SCRIPT_DIR/parse_voice_rank.sh"
        local ordered
        ordered="$(read_last_ordered "6")"
        echo ""
        if [ -n "$ordered" ]; then
          echo ">>> $pid $title: $ordered"
        else
          echo ">>> $pid $title: данные есть, но нет успешных стратегий (или файл пуст)"
        fi
      else
        echo ">>> $pid $title: нет данных — запусти /voice_rank в Discord-боте хотя бы раз"
      fi
      ;;
    7)
      echo ">>> $pid $title: тестер не реализован (сделаем позже)"
      ;;
    *)
      echo ">>> $pid $title: неизвестный профиль" >&2
      ;;
  esac
}

# --- провайдер (для шапки меню) ---
# Автоопределение по внешнему IP через две независимые бесплатные службы
# (без токена) — если первая недоступна/заблокирована, пробуем вторую.
# Результат кэшируем в файл: не хотим дёргать сеть при каждой отрисовке меню.
detect_provider() {
  local isp=""
  isp="$(curl -s -m 5 'http://ip-api.com/line/?fields=isp' 2>/dev/null)"
  if [ -z "$isp" ]; then
    isp="$(curl -s -m 5 'https://ipinfo.io/org' 2>/dev/null | sed -E 's/^AS[0-9]+ //')"
  fi
  if [ -n "$isp" ]; then
    echo "$isp" > "$PROVIDER_CACHE" 2>/dev/null || true
    echo "$isp"
  else
    echo "не определён"
  fi
}

# "PJSC Rostelecom" -> "rostelecom", "MTS PJSC" -> "mts" -- машинный слаг
# для ZENITH_ENVIRONMENT_PROVIDER (см. manage_zenith) вместо ручного ввода.
# Список организационно-правовых обозначений неполный (покрывает то, что
# реально встречается у операторов связи, не претендует на полноту) --
# неизвестное просто лоуеркейзится и схлопывается в [a-z0-9-], тоже
# годный (пусть не идеально короткий) слаг.
slugify_provider() {
  local raw="$1" slug
  slug="$(printf '%s' "$raw" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/\b(pjsc|jsc|ojsc|oao|zao|ooo|llc|ltd|inc|corp|пао|ооо|зао|оао)\b//g' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  # Кириллица (напр. "не определён" -- detect_provider() не смог достучаться
  # ни до одной из двух IP->ISP служб) целиком режется в шаге выше (не
  # [a-z0-9]) -- без этой подстраховки ZENITH_ENVIRONMENT_PROVIDER
  # улетал бы пустой строкой, тихо ломая self-report на панели.
  [ -z "$slug" ] && slug="unknown"
  printf '%s' "$slug"
}

get_provider() {
  if [ -s "$PROVIDER_CACHE" ]; then
    cat "$PROVIDER_CACHE"
  else
    detect_provider
  fi
}

# --- живые статусы компонентов: ON / OFF / NONE ---
# zapret2.service штатно "мёртв" в systemd даже когда nfqws2 реально
# работает (форкает демона в обход cgroup, см. историю этой сессии),
# поэтому проверяем сам процесс, а не юнит.
get_zapret_status() {
  z2r_installed || { echo "NONE"; return; }
  pgrep -x nfqws2 >/dev/null 2>&1 && echo "ON" || echo "OFF"
}

get_daemon_status() {
  [ -f /etc/systemd/system/autotune-daemon.service ] || { echo "NONE"; return; }
  systemctl is-active --quiet autotune-daemon 2>/dev/null && echo "ON" || echo "OFF"
}

# Автономный режим Zenith (генерация + автопродвижение БЕЗ человека) --
# см. zenith_autonomy_menu(). Оба юнита живут В РЕПОЗИТОРИИ Zenith
# ($ZENITH_DIR/zenith-autorun.service/zenith-promoter.service), z0r их
# только копирует+включает, той же схемой, что zenith-panel.service из
# z0r-panel (см. manage_panel).
get_zenith_autorun_status() {
  [ -f /etc/systemd/system/zenith-autorun.service ] || { echo "NONE"; return; }
  systemctl is-active --quiet zenith-autorun 2>/dev/null && echo "ON" || echo "OFF"
}

get_zenith_promoter_status() {
  [ -f /etc/systemd/system/zenith-promoter.service ] || { echo "NONE"; return; }
  systemctl is-active --quiet zenith-promoter 2>/dev/null && echo "ON" || echo "OFF"
}

get_voice_bot_status() {
  [ -d "$VOICE_BOT_DIR" ] || { echo "NONE"; return; }
  systemctl is-active --quiet "$VOICE_BOT_SERVICE" 2>/dev/null && echo "ON" || echo "OFF"
}

# Читает один ключ из $ZENITH_DIR/.env (последнее вхождение, если задан
# дважды). Пусто, если файла/ключа нет — вызывающий код сам подставляет
# дефолт через ${var:-...}.
zenith_env_get() {
  local key="$1"
  [ -f "$ZENITH_DIR/.env" ] || return 0
  grep -E "^${key}=" "$ZENITH_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2-
}

# docker | api — в api-режиме Zenith вообще не трогает Docker/MySQL, своей
# БД тут нет вообще, всё через панель по HTTP (см. README Zenith "Два
# режима БД").
zenith_db_mode() {
  local mode; mode="$(zenith_env_get ZENITH_DB_MODE)"
  echo "${mode:-docker}"
}

# docker | native -- откуда берётся локальная MySQL/MariaDB, только имеет
# смысл когда zenith_db_mode()=docker (своя БД есть; в api своей БД нет
# вообще, бэкенд не проверяется). native = уже установлена в систему
# отдельно (mariadb-server/mysql-server) и настроена вручную (см. README
# Zenith "Нативная БД вместо Docker") -- z0r в этом случае НЕ трогает
# Docker: не поднимает docker-compose, статус/старт-стоп смотрят на
# systemd-юнит mariadb напрямую. См. ask_zenith_db_backend().
zenith_db_backend() {
  local backend; backend="$(zenith_env_get ZENITH_DB_BACKEND)"
  echo "${backend:-docker}"
}

# HTTP-пинг панели для ZENITH_DB_MODE=api -- своей БД тут нет вообще, "SELECT
# 1" недоступен, поэтому статус -- тот же authenticated-запрос, что
# orchestrator/db_api.py делает на каждую реальную операцию.
zenith_panel_ping() {
  local url token name provider
  url="$(zenith_env_get PANEL_URL)"
  token="$(zenith_env_get PANEL_NODE_TOKEN)"
  [ -n "$url" ] && [ -n "$token" ] || return 1
  name="$(zenith_env_get ZENITH_ENVIRONMENT_NAME)"
  provider="$(zenith_env_get ZENITH_ENVIRONMENT_PROVIDER)"
  curl -fsS --max-time 5 \
    -H "Authorization: Bearer $token" \
    -H "X-Node-Name: $name" -H "X-Node-Provider: $provider" \
    "${url%/}/api/v1/db/environment" >/dev/null 2>&1
}

get_zenith_status() {
  [ -d "$ZENITH_DIR" ] || { echo "NONE"; return; }
  if [ "$(zenith_db_mode)" = "api" ]; then
    zenith_panel_ping && echo "ON" || echo "OFF"
  elif [ "$(zenith_db_backend)" = "native" ]; then
    systemctl is-active --quiet mariadb 2>/dev/null && echo "ON" || echo "OFF"
  else
    ( cd "$ZENITH_DIR" && docker compose ps --status running -q 2>/dev/null | grep -q . ) && echo "ON" || echo "OFF"
  fi
}

get_panel_status() {
  [ -d "$PANEL_DIR" ] || { echo "NONE"; return; }
  systemctl is-active --quiet "$PANEL_SERVICE" 2>/dev/null && echo "ON" || echo "OFF"
}

get_tg_relay_status() {
  [ -d "$TGRELAY_DIR" ] || { echo "NONE"; return; }
  systemctl is-active --quiet "$TGRELAY_SERVICE" 2>/dev/null && echo "ON" || echo "OFF"
}

get_dnscrypt_status() {
  command -v dnscrypt-proxy >/dev/null 2>&1 || { echo "NONE"; return; }
  systemctl is-active --quiet dnscrypt-proxy 2>/dev/null && echo "ON" || echo "OFF"
}

autoupdate_conf_get() {
  local project="$1"
  [ -f "$AUTOUPDATE_CONF" ] || { echo "0"; return; }
  local key; key="AUTOUPDATE_$(echo "$project" | tr '[:lower:]' '[:upper:]')"
  grep -E "^${key}=" "$AUTOUPDATE_CONF" 2>/dev/null | tail -1 | cut -d= -f2- || true
}

autoupdate_conf_set() {
  local project="$1" value="$2"
  mkdir -p "$(dirname "$AUTOUPDATE_CONF")"
  touch "$AUTOUPDATE_CONF"
  local key; key="AUTOUPDATE_$(echo "$project" | tr '[:lower:]' '[:upper:]')"
  if grep -qE "^${key}=" "$AUTOUPDATE_CONF" 2>/dev/null; then
    sed -i "s/^${key}=.*/${key}=${value}/" "$AUTOUPDATE_CONF"
  else
    echo "${key}=${value}" >> "$AUTOUPDATE_CONF"
  fi
}

autoupdate_last_update() {
  local project="$1" f
  f="$INSTALL_DIR/logs/autoupdate/${project}.last_update"
  [ -f "$f" ] && cat "$f" || echo "ещё не обновлялось"
}

get_autoupdate_timer_status() {
  systemctl is-enabled --quiet z2r-autoupdate.timer 2>/dev/null && echo "ON" || echo "OFF"
}

install_autoupdate_timer() {
  if [ ! -f "$INSTALL_DIR/z2r-autoupdate.service" ] || [ ! -f "$INSTALL_DIR/z2r-autoupdate.timer" ]; then
    echo "$INSTALL_DIR/z2r-autoupdate.service или .timer не найдены -- обнови z2r_autobench (git pull)." >&2
    return 1
  fi
  chmod +x "$INSTALL_DIR/autoupdate.sh"
  cp -f "$INSTALL_DIR/z2r-autoupdate.service" /etc/systemd/system/z2r-autoupdate.service
  cp -f "$INSTALL_DIR/z2r-autoupdate.timer" /etc/systemd/system/z2r-autoupdate.timer
  systemctl daemon-reload
  systemctl enable --now z2r-autoupdate.timer
  echo "Таймер автообновления установлен и включён (проверка каждые ~20 минут)."
}

# Точка прямого SQL-запроса к БД Zenith через docker exec -- ТОЛЬКО для
# ZENITH_DB_MODE=docker (своя локальная БД). В ZENITH_DB_MODE=api своей
# БД нет вообще -- вызывающий код обязан сам проверить zenith_db_mode()
# и не звать эту функцию (см. zenith_show_provider_strategies/
# zenith_query_profile/zenith_toggle -- ветка "иначе, через панель").
# stderr НЕ глушим (раньше глушили и это один раз уже маскировало
# реальную ошибку SQL как "пусто, генератор не запускался" — путаница,
# на разбор которой ушло время вживую) — единственное исключение:
# get_zenith_status() сам подавляет вывод отдельно, ему нужен только
# код возврата, а не текст ошибки на каждой отрисовке меню.
zenith_mysql_query() {
  local sql="$1" user pass db
  user="$(zenith_env_get MYSQL_USER)"; user="${user:-zenith}"
  pass="$(zenith_env_get MYSQL_PASSWORD)"
  db="$(zenith_env_get MYSQL_DATABASE)"; db="${db:-z2r_genome}"
  # Пароль через MYSQL_PWD, не -p"$pass" — иначе mysql на каждый вызов
  # плюётся "[Warning] Using a password on the command line interface
  # can be insecure" в stderr, а мы его больше не глушим (см. выше).
  if [ "$(zenith_db_backend)" = "native" ]; then
    local client_bin=mariadb
    command -v mariadb >/dev/null 2>&1 || client_bin=mysql
    MYSQL_PWD="$pass" "$client_bin" -u"$user" "$db" -e "$sql"
  else
    ( cd "$ZENITH_DIR" && docker compose exec -T -e MYSQL_PWD="$pass" mysql mysql -u"$user" "$db" -e "$sql" )
  fi
}

# Текущая залоченная стратегия профиля (для "[#N]" в списке профилей).
# 8/9 (fallback) хранятся отдельно, в locked.manual.tsv.
get_locked_strategy() {
  local pid="$1" file="$LOCKED_TSV" val
  case "$pid" in 8|9) file="$LOCKED_MANUAL_TSV" ;; esac
  [ -f "$file" ] || { echo "0"; return; }
  val="$(awk -v p="$pid" -F'\t' '$1==p {print $3; exit}' "$file" 2>/dev/null)"
  echo "${val:-0}"
}

# Цвета для тегов в квадратных скобках ([ON]/[OFF]/[NONE]/[dev]/[бета]).
# $'...' — байты экранирования уже в значении переменной, обычный echo/printf
# без -e их и так выведет как есть.
C_RESET=$'\033[0m'
C_GREEN=$'\033[0;32m'
C_RED=$'\033[0;31m'
C_YELLOW=$'\033[0;33m'
C_CYAN=$'\033[0;36m'
C_GRAY=$'\033[0;90m'

color_tag() {
  local word="$1" color=""
  case "$word" in
    ON) color="$C_GREEN" ;;
    OFF) color="$C_RED" ;;
    NONE) color="$C_GRAY" ;;
    dev) color="$C_YELLOW" ;;
    бета|beta) color="$C_CYAN" ;;
  esac
  printf '%s[%s]%s' "$color" "$word" "$C_RESET"
}

