#!/usr/bin/env bash
# z0r — единая точка входа для z2r_autobench: тестирование профилей z2r,
# автонастройка (демон) и bootstrap самого себя — по аналогии с тем, как
# ставят сам z2r (curl -O .../z2r && sh z2r), можно точно так же:
#
#   curl -O https://raw.githubusercontent.com/scp-oss/z2r_autobench/main/z0r && sh z0r
#
# При запуске НЕ из установленного /opt/z2r_autobench (то есть при самом
# первом запуске свежескачанного файла) z0r сам:
#   - ставит z2r (ядро DPI-обхода), если его ещё нет;
#   - клонирует полный z2r_autobench в /opt/z2r_autobench (если уже
#     склонирован — просто обновляет через git pull);
#   - предлагает поставить фоновый демон автотестирования-автоподстройки
#     (autotune-daemon), если он ещё не установлен — отказался, ничего
#     страшного: демон физически не появится, значит при следующем запуске
#     z0r снова предложит поставить, без отдельного "запоминания отказа";
#   - и наконец перезапускает себя уже из установленной копии.
# При запуске ИЗ УЖЕ установленной копии (обычный "sudo ./z0r" внутри
# /opt/z2r_autobench) — просто тихо подтягивает обновления (git pull, если
# есть доступ к GitHub) и сразу открывает меню/выполняет переданные флаги.
#
# ВАЖНО: подскрипты (rank_strategies.sh/rank_quic.sh) вызываются НАПРЯМУЮ,
# без $(...)-захвата — иначе весь live-вывод (прогресс-бар, "проход N/M")
# уходит в чёрную дыру до самого завершения команды (так и было раньше,
# из-за этого казалось что тест завис). Результат для сводки читаем не
# из stdout, а из файла last_ordered_profile_<N>.txt, который каждый
# подскрипт пишет сам по итогу работы — это разделяет "что показать live"
# и "что вернуть как результат", не заставляя их конфликтовать.
#
# Запуск:
#   sudo ./z0r                  — интерактивное меню
#   sudo ./z0r --profile 1      — тест одного профиля, без меню
#   sudo ./z0r --profiles 1,3,4 — тест выборочного набора профилей
#   sudo ./z0r --all            — все тестируемые профили подряд
#   sudo ./z0r --all --passes 5 — тот же с другим числом проходов
#   sudo ./z0r --domain example.com [--passes 3] [--apply]
#                                — тест конкретного домена (см. ниже)
#   sudo ./z0r --install-service
#                                — установить+включить autotune-daemon.service
#                                  (без меню, для git clone && запусти-и-готово)
#   sudo ./z0r --install-z2r    — поставить сам z2r (ядро DPI-обхода), если его нет
#   sudo ./z0r --install-z2r-offline
#                                — то же самое, но из офлайн-архива автора
#                                  (Google Drive+пароль zator) -- когда GitHub
#                                  у провайдера недоступен целиком, install_z2r()
#                                  сам предложит этот путь после двух зеркал
#   sudo ./z0r --uninstall      — удалить autotune-daemon.service и/или z2r
#                                  (с подтверждением на каждый найденный компонент)
#
# Ниже используются bash-конструкции (declare -A, ${BASH_SOURCE[0]}), поэтому
# скрипт требует bash. Но ставят z2r обычно через "sh z2r" (см. установщик
# автора z2r) — по аналогии кто-нибудь запустит и нас через "sh z0r"/POSIX-sh,
# где всё это упадёт синтаксической ошибкой ещё до первой содержательной
# строки. Ловим это ДО любого башизма и перезапускаемся под bash, ставя его
# при необходимости тем же способом, что и установщик z2r (apt/opkg/apk/...).
if [ -z "${BASH_VERSION:-}" ]; then
  if command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
  echo "z0r требует bash, а его нет в системе — пробую поставить..." >&2
  apt-get update >/dev/null 2>&1 || opkg update >/dev/null 2>&1 || apk update >/dev/null 2>&1
  apt-get install -y bash >/dev/null 2>&1 || opkg install bash >/dev/null 2>&1 || apk add bash >/dev/null 2>&1
  if command -v bash >/dev/null 2>&1; then
    exec bash "$0" "$@"
  fi
  echo "Не удалось поставить bash — z0r без него не запустится. Поставь bash вручную и перезапусти." >&2
  exit 1
fi

set -uo pipefail

# readlink -f -- ${BASH_SOURCE[0]} не резолвится сам через симлинк (напр.
# /usr/local/bin/z0r -> $INSTALL_DIR/z0r, см. ensure_z0r_command) -- без
# этого SCRIPT_DIR при запуске через симлинк указывал бы на /usr/local/bin,
# ломая и все bash "$SCRIPT_DIR/..." вызовы ниже, и сравнение с
# INSTALLED_Z0R в самом низу файла (ложное "Первый запуск").
SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
INSTALL_DIR="/opt/z2r_autobench"
INSTALLED_Z0R="$INSTALL_DIR/z0r"
Z0R_BIN_LINK="/usr/local/bin/z0r"
REPO_URL="https://github.com/scp-oss/z2r_autobench.git"
